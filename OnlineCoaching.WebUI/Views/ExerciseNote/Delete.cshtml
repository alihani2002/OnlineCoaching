@model OnlineCoaching.Domain.Dtos.Notes.ExerciseNoteDto
@{
    ViewData["Title"] = "Delete Note";
}

<h2>Delete Note</h2>

<div class="alert alert-warning">
    <h5>Are you sure you want to delete this note?</h5>
    <p><strong>@Model.Note</strong></p>
    <p><em>Added by @Model.ClientName on @Model.CreatedOn.ToString("g")</em></p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="exerciseId" value="@Model.ExerciseId" />

    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" asp-route-exerciseId="@Model.ExerciseId" class="btn btn-secondary">Cancel</a>
</form>
