@using OnlineCoaching.WebUI.Models.RequestPackage
@model ConfirmRequestViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg rounded-3 border-0">
                <div class="card-header text-white text-center rounded-top" style="background:#ff1313; ">
                    <h3 class="mb-0 text-white">Confirm Coaching Package</h3>
                </div>
                <div class="card-body text-center">
                    <h4 class="fw-bold text-dark">@Model.PackageTitle</h4>
                    <p class="mb-1">
                        <span class="badge bg-info text-white px-3 py-2">
                            Duration: @Model.DurationInMonths months
                        </span>
                    </p>
                    <p>
                        <span class="badge text-white bg-success px-3 py-2">
                            Price: $@Model.PackagePrice
                        </span>
                    </p>

                    <form asp-action="ConfirmRequest" method="post" class="mt-4">
                        <input type="hidden" asp-for="PackageId" />
                        <input type="hidden" asp-for="ClientId" />

                        <button type="submit" class="btn btn-lg btn-success px-4 me-2">
                            <i class="bi bi-check-circle-fill"></i> Confirm Request
                        </button>
                        <a asp-action="Index" asp-controller="CoachingPackages"
                           class="btn btn-lg btn-outline-secondary px-4">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
