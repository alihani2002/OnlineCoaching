@using OnlineCoaching.Domain.Dtos
@model IEnumerable<CoachingPackageRequestDto>

@{
    ViewData["Title"] = "Requests";
}
<style>
    @@media (max-width: 768px) {
        #requestsTable thead

    {
        display: none;
    }

    #requestsTable tbody tr {
        display: block;
        margin-bottom: 1rem;
        border: 1px solid #444;
        border-radius: 10px;
        padding: 10px;
        background: #1a1a1a;
        color: #fff;
    }

    #requestsTable tbody td {
        display: flex;
        justify-content: space-between;
        padding: 8px;
        font-size: 0.9rem;
        border: none;
    }

        #requestsTable tbody td::before {
            content: attr(data-label);
            font-weight: bold;
            color: #ffc107;
        }

    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-gradient">
            <i class="bi bi-list-check me-2"></i> All Requests
        </h2>
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-primary btn-sm rounded-pill shadow-sm">
            <i class="bi bi-house-door me-1"></i> Home
        </a>
    </div>

    <div class="container mt-4">


        <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="requestsTable" class="display table table-bordered table-striped w-100">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th>📦 Package</th>
                                <th>👤 Client</th>
                                <th>📞 Phone</th>
                                <th>📌 Status</th>
                                <th>💲 Price</th>
                                <th>📅 Start</th>
                                <th>⏳ End</th>
                                <th>⚙️ Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@r.Titles</td>
                                    <td>@r.ClientName</td>
                                    <td>@r.PhoneNumber</td>
                                    <td>
                                        @if (r.Status == ClientStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">Pending</span>
                                        }
                                        else if (r.Status == ClientStatus.Active)
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm">Approved</span>
                                        }
                                        else if (r.Status == ClientStatus.Suspended)
                                        {
                                            <span class="badge bg-danger px-3 py-2 rounded-pill shadow-sm">Suspended</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill shadow-sm">@r.Status</span>
                                        }
                                    </td>
                                    <td class="text-success fw-bold">@r.Price</td>
                                    <td>@r.StartDate?.ToShortDateString()</td>
                                    <td>@r.EndDate?.ToShortDateString()</td>
                                    <td>
                                        <button class="btn btn-outline-primary btn-sm rounded-pill me-1 mb-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#statusModal"
                                                data-id="@r.Id"
                                                data-status="@r.Status">
                                            Status
                                        </button>
                                        <a asp-action="Delete" asp-route-id="@r.Id"
                                           class="btn btn-outline-danger btn-sm rounded-pill mb-1">
                                            Remove
                                        </a>
                                        <a asp-controller="Clients" asp-action="ProfileDashboard" asp-route-id="@r.ClientId" class="btn btn-outline-info btn-sm rounded-pill me-1 mb-1">View Profile</a>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <form method="post" asp-action="ChangeStatus">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="statusModalLabel">
                        <i class="bi bi-pencil-square me-2"></i> Change Status
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="RequestId" name="id" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Status</label>
                        <select class="form-select shadow-sm rounded-pill" name="status" id="StatusSelect">
                            <option value="Pending">Pending</option>
                            <option value="Active">Approved</option>
                            <option value="Suspended">Suspended</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success rounded-pill">
                        <i class="bi bi-check-circle me-1"></i> Save
                    </button>
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
 
    <script>
        $(document).ready(function () {
            $('#requestsTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                order: [[0, 'asc']]
            });
        });

        // Modal handling
        var statusModal = document.getElementById('statusModal');
        statusModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var status = button.getAttribute('data-status');

            document.getElementById("RequestId").value = id;
            document.getElementById("StatusSelect").value = status;
        });
    </script>
}