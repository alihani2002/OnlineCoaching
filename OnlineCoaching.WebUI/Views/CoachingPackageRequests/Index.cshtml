@using OnlineCoaching.Domain.Dtos
@model IEnumerable<CoachingPackageRequestDto>

@{
    ViewData["Title"] = "Coaching Requests";
}

<link rel="stylesheet" href="~/css/CoachingRequest-Index.css" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">
            <i class="fas fa-inbox me-2 text-primary"></i> Coaching Requests
        </h2>
        <a asp-action="Index" asp-controller="Home" class="btn btn-primary rounded-pill shadow-sm">
            <i class="fas fa-home me-1"></i> Dashboard Home
        </a>
    </div>

    <div class="card shadow-lg border-0  overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive m-5">
                <table id="requestsTable" class="display table table-hover w-100">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>📦 Package</th>
                            <th>👤 Client</th>
                            <th>📞 Phone</th>
                            <th>📌 Status</th>
                            <th>💲 Price</th>
                            <th>📅 Start</th>
                            <th>⏳ End</th>
                            <th>⚙️ Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="fw-semibold" data-label="Package:">@r.Titles</td>
                                <td data-label="Client:">@r.ClientName</td>
                                <td data-label="Phone:">@r.PhoneNumber</td>
                                <td data-label="Status:">
                                    @{
                                        string badgeClass = "";
                                        string badgeText = "";

                                        if (r.Status == ClientStatus.Pending)
                                        {
                                            badgeClass = "bg-warning text-dark";
                                            badgeText = "Pending";
                                        }
                                        else if (r.Status == ClientStatus.Active)
                                        {
                                            badgeClass = "bg-success";
                                            badgeText = "Approved";
                                        }
                                        else if (r.Status == ClientStatus.Suspended)
                                        {
                                            badgeClass = "bg-danger";
                                            badgeText = "Suspended";
                                        }
                                        else
                                        {
                                            badgeClass = "bg-secondary";
                                            badgeText = r.Status.ToString();
                                        }
                                        <span class="badge @badgeClass px-3 py-2 rounded-pill shadow-sm">@badgeText</span>
                                    }
                                </td>
                                <td class="text-success fw-bold" data-label="Price:">@r.Price</td>
                                <td data-label="Start Date:">@r.StartDate?.ToShortDateString()</td>
                                <td data-label="End Date:">@r.EndDate?.ToShortDateString()</td>
                                <td data-label="Actions:">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill me-1 mb-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#statusModal"
                                            data-id="@r.Id"
                                            data-status="@r.Status">
                                        <i class="fas fa-sync-alt"></i> Status
                                    </button>
                                    <a asp-action="Delete" asp-route-id="@r.Id"
                                       class="btn btn-outline-danger btn-sm rounded-pill mb-1">
                                        <i class="fas fa-trash"></i> Remove
                                    </a>
                                    <a asp-controller="Clients" asp-action="ProfileDashboard" asp-route-id="@r.ClientId" class="btn btn-outline-info btn-sm rounded-pill me-1 mb-1">
                                        <i class="fas fa-user-circle"></i> Profile
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <form method="post" asp-action="ChangeStatus">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="statusModalLabel">
                        <i class="fas fa-edit me-2"></i> Change Request Status
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="RequestId" name="id" />
                    <div class="mb-3">
                        <label for="StatusSelect" class="form-label fw-semibold">Select Status</label>
                        <select class="form-select shadow-sm rounded-pill" name="status" id="StatusSelect">
                            <option value="Pending">Pending</option>
                            <option value="Active">Approved (Active)</option>
                            <option value="Suspended">Suspended</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">
                        <i class="fas fa-times-circle me-1"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-success rounded-pill">
                        <i class="fas fa-check-circle me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTables
            $('#requestsTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                // Disable ordering on the Actions column
                columnDefs: [
                    { orderable: false, targets: [7] }
                ],
                order: [[5, 'desc']] // Order by Start Date descending by default
            });
        });

        // Modal handling
        var statusModal = document.getElementById('statusModal');
        statusModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var status = button.getAttribute('data-status');

            document.getElementById("RequestId").value = id;
            document.getElementById("StatusSelect").value = status;
        });
    </script>
}