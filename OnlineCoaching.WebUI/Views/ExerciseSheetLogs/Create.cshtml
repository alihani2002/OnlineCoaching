@model OnlineCoaching.Domain.Dtos.ExerciseSheet.CreateExerciseSheetDto

@{
    ViewData["Title"] = "Add Exercise Log";
}


<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ClientId" />
    <input type="hidden" asp-for="ExerciseId" />

    <div class="table-responsive">
        <table class="table table-bordered text-center align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Set 1</th>
                    <th>Set 2</th>
                    <th>Set 3</th>
                    <th>Set 4</th>
                    <th>Set 5</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <input asp-for="FirstSet" class="form-control text-center" />
                        <span asp-validation-for="FirstSet" class="text-danger small"></span>
                    </td>
                    <td>
                        <input asp-for="SecondSet" class="form-control text-center" />
                        <span asp-validation-for="SecondSet" class="text-danger small"></span>
                    </td>
                    <td>
                        <input asp-for="ThirdSet" class="form-control text-center" />
                        <span asp-validation-for="ThirdSet" class="text-danger small"></span>
                    </td>
                    <td>
                        <input asp-for="FourthSet" class="form-control text-center" />
                        <span asp-validation-for="FourthSet" class="text-danger small"></span>
                    </td>
                    <td>
                        <input asp-for="FifthSet" class="form-control text-center" />
                        <span asp-validation-for="FifthSet" class="text-danger small"></span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">💾 Save</button>
        @if (User.IsInRole(AppRoles.Client))
        {
            <a asp-controller="Clients" asp-action="Profile" class="btn btn-secondary">Cancel</a>

        }
        <a asp-controller="CoachingPackageRequests" asp-action="index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
