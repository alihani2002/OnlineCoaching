@using OnlineCoaching.Domain.Dtos.ExerciseSheet
@model ExerciseSheetLogDto

@{
    ViewData["Title"] = "Exercise Log Details";
}

<section class="d-flex align-items-center justify-content-center" style="min-height:80vh; background:#f7f7f7;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-9 col-md-10">
                <div class="card shadow-lg border-0 p-5" style="border-radius:20px; background:#fff;">
                    <div class="mb-4 text-center">
                        <h2 class="fw-bold ">@Model.ExerciseName</h2>
                        <p class="text-muted mb-0">Client: <span class="fw-semibold">@Model.ClientName</span></p>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3 fw-bold">First Set</dt>
                        <dd class="col-sm-9">@Model.FirstSet</dd>

                        <dt class="col-sm-3 fw-bold">Second Set</dt>
                        <dd class="col-sm-9">@Model.SecondSet</dd>

                        <dt class="col-sm-3 fw-bold">Third Set</dt>
                        <dd class="col-sm-9">@Model.ThirdSet</dd>

                        <dt class="col-sm-3 fw-bold">Fourth Set</dt>
                        <dd class="col-sm-9">@Model.FourthSet</dd>

                        <dt class="col-sm-3 fw-bold">Fifth Set</dt>
                        <dd class="col-sm-9">@Model.FifthSet</dd>
                    </dl>

                    <div class="mt-4 d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@Model.Id"
                           class="btn btn-warning  fw-bold"
                           style="border-radius:10px;">
                            ✏️ Edit
                        </a>
                        <a asp-controller="Home" asp-action="Index"
                           class="btn btn-secondary fw-bold"
                           style="border-radius:10px;">
                            ⬅ Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
