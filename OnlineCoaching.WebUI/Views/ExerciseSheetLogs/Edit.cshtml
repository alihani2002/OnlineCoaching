@using OnlineCoaching.Domain.Dtos.ExerciseSheet
@model ExerciseSheetLogDto

<h2>Edit Log</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ClientId" />
    <input type="hidden" asp-for="ExerciseId" />

    <table class="table table-bordered text-white">
        <tr>
            <th>First Set</th>
            <td><input asp-for="FirstSet" class="form-control" /></td>
        </tr>
        <tr>
            <th>Second Set</th>
            <td><input asp-for="SecondSet" class="form-control" /></td>
        </tr>
        <tr>
            <th>Third Set</th>
            <td><input asp-for="ThirdSet" class="form-control" /></td>
        </tr>
        <tr>
            <th>Fourth Set</th>
            <td><input asp-for="FourthSet" class="form-control" /></td>
        </tr>
        <tr>
            <th>Fifth Set</th>
            <td><input asp-for="FifthSet" class="form-control" /></td>
        </tr>
    </table>

    <button type="submit" class="btn btn-danger">Update</button>
    <a asp-action="ClientExerciseLogs" asp-route-clientId="@Model.ClientId" asp-route-exerciseId="@Model.ExerciseId" class="btn btn-secondary">Cancel</a>
</form>
