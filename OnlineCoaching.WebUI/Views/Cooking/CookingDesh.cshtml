@model IEnumerable<Cooking>

@{
    ViewData["Title"] = "Cookings";
}

<div class="container mt-4">
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-lg h-100 border-0 rounded-3">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <a href="@item.VideoUrl"
                               data-bs-toggle="modal"
                               data-bs-target="#videoModal"
                               data-video="@item.VideoUrl">
                                <img src="@Url.Content(item.ImageUrl)"
                                     alt="@item.Name"
                                     class="card-img-top rounded-top"
                                     style="height:220px; object-fit:cover;" />

                                <!-- YouTube logo overlay -->
                                @if (!string.IsNullOrEmpty(item.VideoUrl))
                                {
                                    <img src="~/assets/img/logo/youtube.png"
                                         class="position-absolute top-50 start-50 translate-middle"
                                         style="width:60px; height:60px; opacity:0.85; cursor:pointer;" />
                                }
                            </a>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light text-muted"
                                 style="height:220px;">
                                No image
                            </div>
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <h6 class="text-muted">@item.Title</h6>
                        <p class="card-text text-truncate" style="max-height: 60px;">@item.Description</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Video Modal -->
<div class="modal fade bg-black" id="videoModal" tabindex="-1" aria-labelledby="videoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header bg-black border-0">
                <h5 class="modal-title text-white" id="videoModalLabel">Cooking Video</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <!-- YouTube/Vimeo -->
                <iframe id="videoFrame" width="100%" height="400" frameborder="0"
                        allow="autoplay; encrypted-media" allowfullscreen style="display:none"></iframe>

                <!-- MP4/WebM/Ogg -->
                <video id="videoTag" allow="autoplay; encrypted-media" width="100%" height="400" controls style="display:none"></video>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const videoModal = document.getElementById('videoModal');
        const videoFrame = document.getElementById('videoFrame');
        const videoTag = document.getElementById('videoTag');

        function getEmbedUrl(videoUrl) {
            // YouTube normal link
            if (videoUrl.includes("youtube.com/watch")) {
                const videoId = new URL(videoUrl).searchParams.get("v");
                return "https://www.youtube.com/embed/" + videoId + "?autoplay=1";
            }

            // YouTube short link (youtu.be/VIDEOID)
            if (videoUrl.includes("youtu.be")) {
                const videoId = videoUrl.split("youtu.be/")[1];
                return "https://www.youtube.com/embed/" + videoId + "?autoplay=1";
            }

            // Vimeo link
            if (videoUrl.includes("vimeo.com")) {
                const videoId = videoUrl.split("/").pop();
                return "https://player.vimeo.com/video/" + videoId + "?autoplay=1";
            }

            return videoUrl; // for direct mp4/webm/ogg links
        }

        videoModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            const videoUrl = button.getAttribute('data-video');
            const embedUrl = getEmbedUrl(videoUrl);

            if (embedUrl.includes("youtube.com") || embedUrl.includes("vimeo.com")) {
                videoFrame.style.display = "block";
                videoTag.style.display = "none";
                videoFrame.src = embedUrl;
            } else {
                videoFrame.style.display = "none";
                videoTag.style.display = "block";
                videoTag.src = embedUrl;
            }
        });

        videoModal.addEventListener('hidden.bs.modal', () => {
            videoFrame.src = "";
            videoTag.src = "";
        });
    </script>
}
