@model IEnumerable<Cooking>

@{
    ViewData["Title"] = "Cooking Recipes";
}

<link rel="stylesheet" href="~/css/Cooking-Index.css" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">
            <i class="fas fa-utensils me-2 text-primary"></i> Cooking Recipes
        </h2>
        <a asp-controller="Cooking" asp-action="Create" class="btn btn-primary rounded-pill shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Add New Recipe
        </a>
    </div>

    <div class="card shadow-lg border-0 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive m-5">
                <table id="cookingsTable" class="display table table-hover align-middle w-100">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th class="fw-semibold">Recipe Name</th>
                            <th class="fw-semibold">Short Title</th>
                            <th class="fw-semibold">Description</th>
                            <th class="fw-semibold text-center">Image</th>
                            <th class="fw-semibold text-center">Video</th>
                            <th class="fw-semibold text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold" data-label="Recipe Name:">@item.Name</td>
                                <td data-label="Title:">@item.Title</td>
                                <td data-label="Description:">
                                    <span class="d-inline-block text-truncate" style="max-width: 250px;">
                                        @item.Description
                                    </span>
                                </td>
                                <td class="text-center" data-label="Image:">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <a href="#" class="view-image" data-image="@Url.Content(item.ImageUrl)" data-bs-toggle="tooltip" title="Click to view image">
                                            <img src="@Url.Content(item.ImageUrl)" alt="@item.Name" class="rounded shadow-sm border" style="width: 80px; height: 80px; object-fit: cover;" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">N/A</span>
                                    }
                                </td>
                                <td class="text-center" data-label="Video:">
                                    @if (!string.IsNullOrEmpty(item.VideoUrl))
                                    {
                                        <button class="btn btn-outline-info btn-sm rounded-pill" onclick="openVideoModal('@item.VideoUrl')">
                                            <i class="fas fa-play-circle me-1"></i> Watch Video
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">N/A</span>
                                    }
                                </td>
                                <td class="text-center" data-label="Actions:">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light dropdown-toggle border shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fas fa-ellipsis-v"></i> Manage
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            <li><a class="dropdown-item" asp-controller="Cooking" asp-action="Details" asp-route-id="@item.Id"><i class="fas fa-info-circle me-2 text-info"></i>Details</a></li>
                                            <li><a class="dropdown-item" asp-controller="Cooking" asp-action="Edit" asp-route-id="@item.Id"><i class="fas fa-pencil-alt me-2 text-warning"></i>Edit</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a href="#" class="dropdown-item text-danger delete-btn"
                                                   onclick="event.preventDefault();
                                                       if(confirm('Are you sure you want to delete this recipe?')) {
                                                           document.getElementById('deleteForm-@item.Id').submit();
                                                       }">
                                                    <i class="fas fa-trash-alt me-2"></i>Delete
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    <form id="deleteForm-@item.Id"
                                          asp-controller="Cooking" asp-action="Delete" asp-route-id="@item.Id"
                                          method="post" style="display:none;">
                                        @Html.AntiForgeryToken()
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Recipe Image Preview</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <img id="modalImage" src="" class="img-fluid rounded shadow" style="max-height: 70vh;" />
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 shadow-lg">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="videoModalLabel">Recipe Video</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9">
                    <div id="videoContainer" class="d-flex align-items-center justify-content-center bg-dark">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#cookingsTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [2, 3, 4, 5] } // Disable ordering for Description, Image, Video, Actions
                ]
            });

            // Initialize Bootstrap tooltips (for the image link)
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })

            // Image preview modal handler
            $(".view-image").click(function (e) {
                e.preventDefault();
                var imgSrc = $(this).data("image");
                $("#modalImage").attr("src", imgSrc);
                new bootstrap.Modal(document.getElementById("imagePreviewModal")).show();
            });

            // Video modal handler
            const videoModal = document.getElementById('videoModal');
            const videoContainer = document.getElementById("videoContainer");

            videoModal.addEventListener('hidden.bs.modal', function () {
                videoContainer.innerHTML = ''; // Stop video playback
            });

            window.openVideoModal = function (url) {
                let embedHtml = "";

                if (url.includes("youtube.com") || url.includes("youtu.be")) {
                    let videoId = "";
                    if (url.includes("youtu.be")) {
                        videoId = url.split("/").pop();
                    } else {
                        const urlObj = new URL(url);
                        const urlParams = new URLSearchParams(urlObj.search);
                        videoId = urlParams.get("v");
                    }
                    embedHtml = `<iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1"
                                 frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                 allowfullscreen class="embed-responsive-item"></iframe>`;
                } else if (url.includes("vimeo.com")) {
                    const videoId = url.split("/").pop();
                    embedHtml = `<iframe src="https://player.vimeo.com/video/${videoId}?autoplay=1"
                                 frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen class="embed-responsive-item"></iframe>`;
                } else {
                    // Direct video link
                    embedHtml = `<video controls autoplay class="embed-responsive-item p-3">
                                     <source src="${url}" type="video/mp4">
                                     Your browser does not support the video tag.
                                 </video>`;
                }

                videoContainer.innerHTML = embedHtml;
                new bootstrap.Modal(videoModal).show();
            }
        });
    </script>
}