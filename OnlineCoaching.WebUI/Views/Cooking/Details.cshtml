@using OnlineCoaching.Domain.Dtos.Cooking
@model Cookingdto

@{
    ViewData["Title"] = "Cooking Details";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Recipe Details</h2>
    </div>


    <div class="card shadow-lg rounded-4 overflow-hidden">
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-12">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Url.Content(Model.ImageUrl)" alt="@Model.Name" class="img-fluid rounded-4 shadow-sm" style="max-height: 400px; width: 100%; object-fit: cover;" />
                    }
                </div>

                <div class="col-12">
                    <h4 class="fw-bold text-primary">@Model.Title</h4>
                    <h5 class="text-muted">By: @Model.Name</h5>
                </div>

                <div class="col-12">
                    <h6 class="fw-semibold">Description</h6>
                    <p>@Model.Description</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <div class="col-12">
                        <h6 class="fw-semibold">Video</h6>
                        <a href="@Model.VideoUrl" target="_blank" class="btn btn-outline-dark">
                            <i class="bi bi-play-circle-fill me-2"></i>Watch Video
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
            <i class="bi bi-pencil-square me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-secondary px-4">
            <i class="bi bi-arrow-left-circle me-1"></i> Back to List
        </a>
    </div>
</div>