@using OnlineCoaching.Domain.Dtos.Cooking
@model Cookingdto

@{
    ViewData["Title"] = "Delete Cooking";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card shadow-lg rounded-4 border-0">
        <div class="card-header bg-danger text-white text-center py-4">
            <h3 class="fw-bold mb-0">Delete Recipe</h3>
        </div>
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
                <h4 class="mt-3">Are you sure you want to delete this recipe?</h4>
                <p class="text-muted">This action cannot be undone.</p>
            </div>

            <hr />

            <h5 class="fw-bold mb-3">Recipe Details</h5>
            <dl class="row">
                <dt class="col-sm-4 text-dark fw-semibold">Name:</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4 text-dark fw-semibold">Title:</dt>
                <dd class="col-sm-8">@Model.Title</dd>

                <dt class="col-sm-4 text-dark fw-semibold">Description:</dt>
                <dd class="col-sm-8">@Model.Description</dd>
            </dl>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash-fill me-1"></i> Delete
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
            </div>
        </div>
    </div>
</div>