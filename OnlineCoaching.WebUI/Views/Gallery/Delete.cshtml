@model OnlineCoaching.Domain.Dtos.Gallery.GalleryDto

@{
    ViewData["Title"] = "Delete Image";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Image</h2>
    <hr />

    <div class="alert alert-warning">
        <strong>Are you sure you want to delete this image?</strong>
    </div>

    <div class="card shadow-sm p-3 mb-4">
        <div class="text-center">
            <img src="@Model.Image" alt="Gallery Image" class="img-fluid rounded" style="max-height:300px;" />
        </div>
        <div class="mt-3">
            <p><strong>Image ID:</strong> @Model.Id</p>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Delete
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Cancel
        </a>
    </form>
</div>
