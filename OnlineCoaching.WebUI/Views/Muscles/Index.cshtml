@model IEnumerable<OnlineCoaching.Domain.Dtos.MuscleDto>

@{
    ViewData["Title"] = "Muscles";
}

<h2 class="mb-3">Muscles</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Muscle</a>
</p>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<table id="musclesTable" class="display table table-bordered table-striped" style="width:100%">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Created On</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var muscle in Model)
        {
            <tr>
                <td>@muscle.Name</td>
                <td>@muscle.Description</td>
                <td>@muscle.CreatedOn.ToString("yyyy-MM-dd")</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton-@muscle.Id" data-bs-toggle="dropdown" aria-expanded="false">
                            Actions
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-@muscle.Id">
                            <li><a class="dropdown-item text-dark" asp-action="Details" asp-route-id="@muscle.Id">Details</a></li>
                            <li><a class="dropdown-item text-dark" asp-action="Edit" asp-route-id="@muscle.Id">Edit</a></li>
                            <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@muscle.Id">Delete</a></li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#musclesTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                order: [[0, 'asc']]
            });
        });
    </script>
}
