@model Question

@{
    ViewData["Title"] = "Question Details";
}

<link rel="stylesheet" href="~/css/Question-Details.css" />


<div class="container mt-5">
    <div class="card details-card">
        <div class="card-header details-card-header">
            <h4 class="mb-0 text-white">
                <i class="fas fa-question-circle me-2"></i>
                Question Details
            </h4>
        </div>

        <div class="card-body details-card-body">
            <dl class="row details-list">
                <dt class="col-sm-3">Question Text:</dt>
                <dd class="col-sm-9">@Model.Text</dd>

                <dt class="col-sm-3">Type:</dt>
                <dd class="col-sm-9">@Model.Type</dd>

                <dt class="col-sm-3">Allow Multiple Answers:</dt>
                <dd class="col-sm-9">
                    @(Model.AllowMultipleAnswers ? "Yes" : "No")
                </dd>
            </dl>

            @if (Model.Options != null && Model.Options.Any())
            {
                <div class="options-section">
                    <h5 class="mb-3 pb-2 border-bottom text-primary">
                        <i class="fas fa-list me-2"></i>
                        Available Options (@Model.Options.Count)
                    </h5>
                    <ul class="list-group">
                        @foreach (var option in Model.Options)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center options-list-group-item">
                                <i class="far fa-circle details-icon"></i>
                                @option.Text
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-4" role="alert">
                    <i class="fas fa-info-circle me-2"></i>
                    This question does not have any selectable options.
                </div>
            }

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-custom">
                    <i class="fas fa-edit me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary btn-custom">
                    <i class="fas fa-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>