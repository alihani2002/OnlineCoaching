@model IEnumerable<Question>

@{
    ViewData["Title"] = "Table Questions";
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Question</a>
</p>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<table id="questionsTable" class="display table table-bordered table-striped" style="width:100%">
    <thead>
        <tr>
            <th>#</th>
            <th>Text</th>
            <th>Type</th>
            <th>Allow Multiple Answers</th>
            <th>Options Count</th>
            <th>Options</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.NumberOfQuestion</td>
                    <td>@item.Text</td>
                    <td>@item.Type</td>
                    <td>@(item.AllowMultipleAnswers ? "Yes" : "No")</td>
                    <td>@(item.Options?.Count ?? 0)</td>
                    <td>
                        @if (item.Options != null && item.Options.Any())
                        {
                            <ul class="mb-0">
                                @foreach (var option in item.Options)
                                {
                                    <li>@option.Text</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">No options</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">View</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No questions found.</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#questionsTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                order: [[0, 'asc']]
            });
        });
    </script>
}
