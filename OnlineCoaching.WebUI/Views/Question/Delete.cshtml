@model Question

@{
    ViewData["Title"] = "Delete Question";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Delete Question</h3>
        </div>
        <div class="card-body">
            <h5 class="text-danger fw-bold mb-3">
                Are you sure you want to delete this question?
            </h5>

            <dl class="row">
                <dt class="col-sm-3">Question Text</dt>
                <dd class="col-sm-9">@Model.Text</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">@Model.Type</dd>

                <dt class="col-sm-3">Created On</dt>
                <dd class="col-sm-9">@Model.CreatedOn.ToString("dd/MM/yyyy")</dd>
            </dl>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
