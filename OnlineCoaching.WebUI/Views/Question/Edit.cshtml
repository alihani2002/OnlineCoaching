@model Question

@{
    var options = Model.Options?.ToList() ?? new List<Option>();
    ViewData["Title"] = "Edit Question";
}

<link rel="stylesheet" href="~/css/Question-Edit.css" />


<div class="container-fluid">
    <div class="edit-card">
        <div class="form-header">
            <h2>
                <i class="fas fa-edit me-2"></i>
                Edit Question
            </h2>
            <p class="text-muted">Update the details of your question and its options.</p>
        </div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-4">
                <label asp-for="NumberOfQuestion" class="form-label">Question Number (optional):</label>
                <input asp-for="NumberOfQuestion" type="number" min="1" class="form-control" />
            </div>

            <div class="mb-4">
                <label asp-for="Text" class="form-label">Question Text:</label>
                <textarea asp-for="Text" class="form-control" rows="4" required></textarea>
                <span asp-validation-for="Text" class="text-danger mt-1"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Type" class="form-label">Question Type:</label>
                <select asp-for="Type" class="form-select" id="questionType">
                    <option value="SingleChoice" selected="@((Model.Type == QuestionType.SingleChoice))">Single Choice</option>
                    <option value="MultipleChoice" selected="@((Model.Type == QuestionType.MultipleChoice))">Multiple Choice</option>
                    <option value="OpenText" selected="@((Model.Type == QuestionType.OpenText))">Open Text</option>
                </select>
            </div>

            <div class="form-check form-switch mb-4">
                <input asp-for="AllowMultipleAnswers" class="form-check-input" type="checkbox" id="AllowMultipleAnswers" />
                <label asp-for="AllowMultipleAnswers" class="form-check-label">Allow Multiple Answers</label>
            </div>

            <div id="optionsAndActions">
                <div id="optionsSection" class="options-section">
                    <h5 class="fw-bold mb-3">
                        <i class="fas fa-list me-2 text-secondary"></i>Options
                    </h5>
                    <div id="optionsContainer">
                        @if (options.Any())
                        {
                            for (int i = 0; i < options.Count; i++)
                            {
                                <div class="option-block d-flex align-items-center mb-3">
                                    <input type="text" name="Options[@i].Text" value="@options[i].Text" class="form-control" required />
                                    <button type="button" class="btn btn-remove-option ms-2" onclick="this.closest('.option-block').remove()">
                                        <i class="fas fa-times"></i>
                                    </button>
                                    <input type="hidden" name="Options[@i].Id" value="@options[i].Id" />
                                </div>
                            }
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-add-option mt-2" onclick="addOption()">
                        <i class="fas fa-plus me-1"></i> Add Option
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">
                <button type="submit" class="btn btn-primary btn-save-changes">
                    <i class="fas fa-save me-1"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-cancel">
                    <i class="fas fa-arrow-left me-1"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const questionTypeDropdown = document.getElementById("questionType");
        const optionsAndActions = document.getElementById("optionsAndActions");
        const allowMultipleCheckbox = document.getElementById("AllowMultipleAnswers");

        function toggleOptionsByType() {
            const val = questionTypeDropdown.value;

            if (val === "OpenText") {
                optionsAndActions.style.display = "none";
                allowMultipleCheckbox.checked = false;
                allowMultipleCheckbox.disabled = true;
            } else {
                optionsAndActions.style.display = "block";
                allowMultipleCheckbox.disabled = false;

                if (val === "MultipleChoice") {
                    allowMultipleCheckbox.checked = true;
                } else if (val === "SingleChoice") {
                    allowMultipleCheckbox.checked = false;
                }
            }
        }

        function addOption() {
            const container = document.getElementById("optionsContainer");
            const optionIndex = container.querySelectorAll(".option-block").length;
            const optionHtml = `
                <div class="option-block d-flex align-items-center mb-3">
                    <input type="text" name="Options[${optionIndex}].Text" class="form-control" placeholder="Option text" required />
                    <button type="button" class="btn btn-remove-option ms-2" onclick="this.closest('.option-block').remove()">
                        <i class="fas fa-times"></i>
                    </button>
                    <input type="hidden" name="Options[${optionIndex}].Id" value="0" />
                </div>`;
            container.insertAdjacentHTML("beforeend", optionHtml);
        }

        document.addEventListener("DOMContentLoaded", toggleOptionsByType);
        questionTypeDropdown.addEventListener("change", toggleOptionsByType);
    </script>
}