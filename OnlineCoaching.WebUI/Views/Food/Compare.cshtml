@model OnlineCoaching.WebUI.Core.ViewModels.Food.FoodCompareViewModel
@{
    ViewData["Title"] = "Protein Food Swap Calculator";
}
<style>
    #SelectedFoodId,
    #TargetFoodId {
        display: none !important;
        visibility: hidden !important;
    }
</style>
<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h2 class="card-title fw-bolder">⚖️ Protein Food Swap Calculator</h2>
                        <p class="text-muted">Find out how much of a different food you need to get the same amount of protein.</p>
                    </div>

                    <form asp-action="Compare" method="post">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label for="SelectedFoodId" class="form-label fw-bold">1. Start with this food</label>
                                <select id="SelectedFoodId" name="SelectedFoodId" hidden></select>
                            </div>
                            <div class="col-md-4">
                                <label for="Grams" class="form-label fw-bold">2. Enter amount</label>
                                <div class="input-group input-group-lg">
                                    <input asp-for="Grams" type="number" class="form-control" min="1" placeholder="e.g., 150" required />
                                    <span class="input-group-text">g</span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mt-3 mb-4">
                            <div class="col-md-12">
                                <label for="TargetFoodId" class="form-label fw-bold">3. Swap it for this food</label>
                                <select id="TargetFoodId" name="TargetFoodId" hidden></select>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-arrow-left-right me-2"></i> Calculate Swap
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

    @if (Model.SelectedFood != null && Model.TargetFood != null && Model.Grams > 0)
    {
        // Pre-calculate values here to keep the HTML clean
        var totalProtein = (Model.SelectedFood.Protein / (double)Model.SelectedFood.Gram) * Model.Grams;
        var calorieDifference = Model.TargetFoodCalories - Model.SelectedFoodCalories;
        var calorieAlertClass = calorieDifference > 0 ? "alert-danger" : "alert-success";
        var calorieText = calorieDifference > 0 ? $"an extra {calorieDifference:F0}" : $"you save {-calorieDifference:F0}";

        <div class="row justify-content-center mt-4" id="results">
            <div class="col-xl-8 col-lg-10">
                <div class="text-center mb-3">
                    <h3 class="fw-bold text-white">📊 Comparison Result</h3>
                </div>

                <div class="row g-4">
                    <div class="col-md-6 d-flex">
                        <div class="card shadow-sm w-100">
                            <div class="card-header bg-light fw-bold text-center">Your Entry</div>
                            <div class="card-body">
                                <h4 class="card-title text-center text-primary">@Model.SelectedFood.Name</h4>
                                <h2 class="display-5 fw-bold text-center">@Model.Grams <span class="fs-4 text-muted">g</span></h2>
                                <hr />
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>🧬 Protein</span>
                                        <span class="badge bg-primary rounded-pill fs-6">@totalProtein.ToString("0.0") g</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>🔥 Calories</span>
                                        <span class="badge bg-secondary rounded-pill fs-6">@Model.SelectedFoodCalories.ToString("0.0") kcal</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 d-flex">
                        <div class="card shadow-sm w-100 border-success border-2">
                            <div class="card-header bg-success text-white fw-bold text-center">The Swap</div>
                            <div class="card-body">
                                <h4 class="card-title text-center text-success">@Model.TargetFood.Name</h4>
                                <h2 class="display-5 fw-bold text-center">@Model.RequiredTargetGrams.ToString("0.0") <span class="fs-4 text-muted">g</span></h2>
                                <hr />
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>🧬 Protein</span>
                                        <span class="badge bg-primary rounded-pill fs-6">@totalProtein.ToString("0.0") g</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>🔥 Calories</span>
                                        <span class="badge bg-secondary rounded-pill fs-6">@Model.TargetFoodCalories.ToString("0.0") kcal</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert @calorieAlertClass text-center mt-4 shadow-sm" role="alert">
                    <h5 class="alert-heading mb-0">
                        By swapping, you will consume <strong>@calorieText calories</strong> for the same amount of protein.
                    </h5>
                </div>

            </div>
        </div>
    }
</div>


@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            // Function to initialize Select2 on a given element
            // This avoids repeating the same configuration
            function initializeFoodSearch(selector, placeholder) {
                $(selector).select2({
                    placeholder: placeholder,
                    allowClear: true,
                    width: '100%',
                    theme: 'bootstrap-5',
                    ajax: {
                        url: '/Food/Search', // Your API endpoint for searching foods
                        dataType: 'json',
                        delay: 250,
                        data: function (params) {
                            return { term: params.term };
                        },
                        processResults: function (data) {
                            return { results: data };
                        },
                        cache: true
                    }
                });
            }

            // Initialize both select boxes
            initializeFoodSearch('#SelectedFoodId', '-- Search for a food --');
            initializeFoodSearch('#TargetFoodId', '-- Search for a replacement --');
        });
    </script>
}

