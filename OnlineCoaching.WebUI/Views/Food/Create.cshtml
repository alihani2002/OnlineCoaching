@model OnlineCoaching.Domain.Entities.Food

@{
    ViewData["Title"] = "Create Food";
}

<div class="card shadow-sm p-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold"></label>
            <input asp-for="Name" class="form-control" placeholder="Enter food name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="Calories" class="form-label fw-bold"></label>
                <input asp-for="Calories" class="form-control" placeholder="0" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Protein" class="form-label fw-bold"></label>
                <input asp-for="Protein" class="form-control" placeholder="0 g" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Carbs" class="form-label fw-bold"></label>
                <input asp-for="Carbs" class="form-control" placeholder="0 g" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="Fats" class="form-label fw-bold"></label>
                <input asp-for="Fats" class="form-control" placeholder="0 g" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold"></label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description..."></textarea>
        </div>

        <!-- Image upload -->
        <div class="mb-3">
            <label class="form-label fw-bold">Food Image</label>
            <input type="file" name="ImageFile" class="form-control" accept="image/*" />
            <div class="small text-muted mt-1">Upload a food image (optional)</div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </form>
</div>
