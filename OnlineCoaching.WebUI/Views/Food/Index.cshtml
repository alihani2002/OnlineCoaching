@model IEnumerable<OnlineCoaching.Domain.Dtos.FoodDto>

@{
    ViewData["Title"] = "Food Catalog";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-dark">Food Catalog</h2>
        <a asp-action="Create" class="btn btn-primary shadow">
            <i class="bi bi-plus-circle-fill me-2"></i> Add New Food
        </a>
    </div>
    <div class="card shadow-lg rounded-4">
        <div class="card-body">
            <table class="display table align-middle mb-0 text-dark" id="foodsTable" style="width:100%">
                <thead class="bg-light">
                    <tr>
                        <th class="text-secondary fw-semibold">Food</th>
                        <th class="text-secondary fw-semibold">Gram</th>
                        <th class="text-secondary fw-semibold">Calories</th>
                        <th class="text-secondary fw-semibold">Protein</th>
                        <th class="text-secondary fw-semibold">Carbs</th>
                        <th class="text-secondary fw-semibold">Fats</th>
                        <th class="text-secondary fw-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="~/assets/img/logo/noimage.jpg"
                                         alt="food image"
                                         class="rounded-circle me-3"
                                         style="width: 45px; height: 45px; object-fit: cover;" />
                                    <div>
                                        <p class="fw-bold mb-1 text-dark">@item.Name</p>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary fw-bold rounded-pill">@item.Gram g</span></td>
                            <td><span class="badge bg-primary-subtle text-primary fw-bold rounded-pill">@item.Calories kcal</span></td>
                            <td><span class="badge bg-success-subtle text-success fw-bold rounded-pill">@item.Protein g</span></td>
                            <td><span class="badge bg-warning-subtle text-warning fw-bold rounded-pill">@item.Carbs g</span></td>
                            <td><span class="badge bg-info-subtle text-info fw-bold rounded-pill">@item.Fats g</span></td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-info-circle me-2"></i>Details</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil-square me-2"></i>Edit</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash-fill me-2"></i>Delete</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
 
    <script>
        $(document).ready(function () {
            $('#foodsTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                order: [[0, 'asc']]
            });
        });
    </script>
}