@model IEnumerable<OnlineCoaching.Domain.Dtos.CoachingPackageDto>
@{
    ViewData["Title"] = "Coaching Packages";
}

<section class="pricing-area section-padding40 fix">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="section-tittle text-center mb-55 wow fadeInUp" data-wow-duration="2s" data-wow-delay=".1s">
                    <h2>Pricing</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @if (Model != null && Model.Any())
            {
                var delay = 0.2;
                foreach (var package in Model)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="properties mb-30 wow fadeInUp" data-wow-duration="1s" data-wow-delay="@($"{delay}s")">
                            <div class="properties__card">
                                <div class="about-icon">
                                    <img src="~/assets/img/icon/price.svg" alt="Price Icon">
                                </div>
                                <div class="properties__caption">
                                    <span class="month">@package.DurationInMonths month@(package.DurationInMonths > 1 ? "s" : "")</span>
                                    <p class="mb-25">$@package.Price/m <span>(Single class)</span></p>
                                    <div class="single-features">
                                        <div class="features-icon">
                                            <img src="~/assets/img/icon/check.svg" alt="">
                                        </div>
                                        <div class="features-caption">
                                            <p>@package.Description</p>
                                        </div>
                                    </div>
                                    <!-- Add more static or dynamic features here if needed -->
                                    <a href="@Url.Action("ConfirmRequest", "CoachingPackageRequests", new { packageId = package.Id })"
                                       class="border-btn border-btn2">Join Now</a>

                                </div>
                            </div>
                        </div>
                    </div>
                    delay += 0.2;
                }
            }
       
            else
            {
                <div class="col-12">
                    <p class="text-center">No coaching packages available at the moment.</p>
                </div>
            }
        </div>
    </div>
</section>
