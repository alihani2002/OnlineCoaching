@model IEnumerable<OnlineCoaching.Domain.Dtos.CoachingPackageDto>
@{
    ViewData["Title"] = "Coaching Packages";
}

<section class="pricing-area section-padding40 fix">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="section-tittle text-center mb-55 wow fadeInUp" data-wow-duration="2s" data-wow-delay=".1s">
                    <h2>Pricing</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @if (Model != null && Model.Any())
            {
                var delay = 0.2;
                foreach (var package in Model)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="properties mb-30 wow fadeInUp" data-wow-duration="1s" data-wow-delay="@($"{delay}s")">
                            <div class="properties__card">
                                <div class="about-icon">
                                    <img src="~/assets/img/icon/price.svg" alt="Price Icon">
                                </div>
                                <div class="properties__caption">
                                    <span class="month">@package.DurationInMonths month@(package.DurationInMonths > 1 ? "s" : "")</span>
                                    <p class="mb-25">L.E @package.Price/m <span>(Single class)</span></p>
                                    <div class="single-features">
                                        <div class="features-icon">
                                            <img src="~/assets/img/icon/check.svg" alt="">
                                        </div>
                                        <div class="features-caption">
                                            <p>@package.Description</p>
                                        </div>
                                    </div>

                                    <!-- Trigger Modal -->
                                    <a href="javascript:void(0)"
                                       class="border-btn border-btn2"
                                       data-toggle="modal"
                                       data-target="#confirmModal"
                                       data-id="@package.Id"
                                       data-name="@package.Description"
                                       data-price="@package.Price">
                                        Join Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    delay += 0.2;
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-center">No coaching packages available at the moment.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="confirmRequestForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmModalLabel">Confirm Package Request</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="modal-text">Are you sure you want to join this package?</p>
                    <input type="hidden" id="PackageId" name="PackageId" />
                    <input type="hidden" id="ClientId" name="ClientId" value="@ViewBag.Client" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content text-center p-4">
            <h3 class="text-success">✅ Request Done</h3>
            <p>Your coaching package request has been submitted successfully.</p>
            <button type="button" id="successOkBtn" class="btn btn-success mt-3">OK</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // When confirm modal opens, set values
        $('#confirmModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var packageId = button.data('id');
            var packageName = button.data('name');
            var packagePrice = button.data('price');

            var modal = $(this);
            modal.find('#PackageId').val(packageId);
            modal.find('#modal-text').text(
                "Are you sure you want to join the package: " + packageName + " for $" + packagePrice + "/month?"
            );
        });

        // Handle form submit via AJAX
        $('#confirmRequestForm').submit(function (e) {
            e.preventDefault();
            var formData = $(this).serialize();

            $.ajax({
                url: '@Url.Action("ConfirmRequest", "CoachingPackageRequests")',
                type: 'POST',
                data: formData,
                success: function (response) {
                    $('#confirmModal').modal('hide');   // Close confirm modal
                    $('#successModal').modal('show');   // Show success popup
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                    alert("❌ Failed to submit request. Please try again.");
                }
            });
        });

        // Redirect on OK click
        $('#successOkBtn').on('click', function () {
            window.location.href = '@Url.Action("GetCoachingPackage", "CoachingPackages")';
        });
    </script>
}
