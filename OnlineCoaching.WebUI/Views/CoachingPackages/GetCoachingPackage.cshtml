@model IEnumerable<OnlineCoaching.Domain.Dtos.CoachingPackageDto>
@{
    ViewData["Title"] = "Coaching Packages";
}



<section class="pricing-area section-padding40 fix">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="section-tittle text-center mb-55 wow fadeInUp" data-wow-duration="2s" data-wow-delay=".1s">
                    <h2>Pricing</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @if (Model != null && Model.Any())
            {
                var delay = 0.2;
                foreach (var package in Model)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="properties mb-30 wow fadeInUp" data-wow-duration="1s" data-wow-delay="@($"{delay}s")">
                            <div class="properties__card">

                                <!-- Package Image -->
                                @if (!string.IsNullOrEmpty(package.ImageUrl))
                                {
                                    <div class="mb-3">
                                        <img src="@package.ImageUrl"
                                             alt="@package.Title"
                                             class="img-fluid rounded shadow-sm"
                                             style="max-height:250px; object-fit:cover; width:100%;" />
                                    </div>
                                }

                              
                                <div class="properties__caption text-center">
                                    <h5 class="fw-bold text-white">@package.Title</h5>
                                    <span class="month">@package.DurationInMonths month@(package.DurationInMonths > 1 ? "s" : "")</span>
                                    <p class="mb-25 fs-5 fw-bold text-warning">
                                        L.E @package.Price <span class="text-muted">/ month</span>
                                    </p>

                                    <div class="single-features text-start">
                                        <div class="features-icon">
                                            <img src="~/assets/img/icon/check.svg" alt="">
                                        </div>
                                        <div class="features-caption">
                                            <p>@package.Description</p>
                                        </div>
                                    </div>

                                    <!-- Trigger Modal -->
                                    <a asp-controller="CoachingPackageRequests" asp-action="ConfirmRequestView" asp-route-id="@package.Id" class="border-btn border-btn2"> Join Now </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    delay += 0.2;
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-center">No coaching packages available at the moment.</p>
                </div>
            }
        </div>
    </div>
</section>


@section Scripts {
    <script>
        // When confirm modal opens, set values
        $('#confirmModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var packageId = button.data('id');
            var packageName = button.data('name');
            var packagePrice = button.data('price');

            var modal = $(this);
            modal.find('#PackageId').val(packageId);
            modal.find('#modal-text').text(
                "Are you sure you want to join the package: " + packageName + " for $" + packagePrice + "/month?"
            );
        });

        // Handle form submit via AJAX
        $('#confirmRequestForm').submit(function (e) {
            e.preventDefault();
            var formData = $(this).serialize();

            $.ajax({
                url: '@Url.Action("ConfirmRequest", "CoachingPackageRequests")',
                type: 'POST',
                data: formData,
                success: function (response) {
                    $('#confirmModal').modal('hide');   // Close confirm modal
                    $('#successModal').modal('show');   // Show success popup
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                    alert("❌ Failed to submit request. Please try again.");
                }
            });
        });

        // Redirect on OK click
        $('#successOkBtn').on('click', function () {
            window.location.href = '@Url.Action("GetCoachingPackage", "CoachingPackages")';
        });
    </script>
}
