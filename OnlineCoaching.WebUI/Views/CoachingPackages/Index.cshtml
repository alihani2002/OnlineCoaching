@model IEnumerable<OnlineCoaching.Domain.Dtos.CoachingPackageDto>
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Coaching Packages";
}

<div class="container mt-5">
    <div class="row text-center mb-5">
        <div class="col-12">
            <h2 class="fw-bold text-dark">Our Coaching Packages</h2>
            <p class="text-muted">Choose the plan that's right for you to start your fitness journey.</p>
        </div>
    </div>

    @if (SignInManager.IsSignedIn(User) && User.IsInRole(AppRoles.Admin))
    {
        <div class="row mb-4">
            <div class="col-12 text-end">
                <a asp-action="Create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-circle-fill me-1"></i> Add New Package
                </a>
            </div>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4 justify-content-center">
            @foreach (var package in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-lg rounded-4 border-0">
                        <div class="card-body p-4 text-center">
                            <h4 class="card-title fw-bold mb-3">@package.Title</h4>
                            <p class="fs-1 fw-bold mb-1 text-primary">
                                L.E @package.Price
                            </p>
                            <p class="text-muted">per month</p>
                            <span class="badge bg-secondary mb-3">@package.DurationInMonths month@(package.DurationInMonths > 1 ? "s" : "")</span>

                            <hr class="my-4" />

                            <ul class="list-unstyled text-start mb-4 flex-grow-1">
                                @if (!string.IsNullOrEmpty(package.Description))
                                {
                                    // Split the description string by the hyphen '-' and trim whitespace from each part.
                                    var descriptionItems = package.Description.Split('-').Select(s => s.Trim()).ToList();

                                    @for (int i = 0; i < descriptionItems.Count; i++)
                                    {
                                        // Skip the first item if it's empty due to a leading hyphen.
                                        if (i == 0 && string.IsNullOrWhiteSpace(descriptionItems[i]))
                                        {
                                            continue;
                                        }

                                        <li class="mb-2">
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            @descriptionItems[i]
                                        </li>
                                    }
                                }
                            </ul>

                            @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole(AppRoles.Client))
                            {
                                <a href="@Url.Action("ConfirmRequest", "CoachingPackageRequests", new { packageId = package.Id })"
                                   class="btn btn-primary w-100 mt-auto">Join Now</a>
                            }
                            else if (!User.Identity!.IsAuthenticated)
                            {
                                <a href="~/Identity/Account/Login"
                                   class="btn btn-primary w-100 mt-auto">Join Now</a>
                            }

                            @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Coach))
                            {
                                <div class="d-flex justify-content-center gap-2 mt-3">
                                    <a class="btn btn-outline-info btn-sm" asp-action="Details" asp-route-id="@package.Id">Details</a>
                                    <a class="btn btn-outline-warning btn-sm" asp-action="Edit" asp-route-id="@package.Id">Edit</a>
                                    <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@package.Id">Delete</a>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <h4 class="alert-heading">No packages available!</h4>
            <p>There are no coaching packages listed at the moment. Please check back later.</p>
        </div>
    }
</div>