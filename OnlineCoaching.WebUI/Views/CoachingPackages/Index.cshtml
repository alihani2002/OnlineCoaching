@model IEnumerable<OnlineCoaching.Domain.Dtos.CoachingPackageDto>
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Coaching Packages";
}

<!-- ================== Coaching Packages ================== -->
<section class="pricing-area section-padding40 fix">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="section-tittle text-center mb-55">
                    <h2>Our Coaching Packages</h2>
                    <p class="text-muted">Choose the plan that's right for you to start your fitness journey.</p>
                </div>
            </div>
        </div>

        @if (SignInManager.IsSignedIn(User) && User.IsInRole(AppRoles.Admin))
        {
            <div class="row mb-4">
                <div class="col-12 text-end">
                    <a asp-action="Create" class="btn btn-primary shadow-sm">
                        <i class="bi bi-plus-circle-fill me-1"></i> Add New Package
                    </a>
                </div>
            </div>
        }

        <div class="row">
            @if (Model != null && Model.Any())
            {
                @foreach (var package in Model)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="properties mb-30">
                            <div class="properties__card shadow-lg p-3 rounded-4">

                                <!-- Package Image -->
                                @if (!string.IsNullOrEmpty(package.ImageUrl))
                                {
                                    <div class="mb-3">
                                        <img src="@package.ImageUrl"
                                             alt="@package.Title"
                                             class="img-fluid rounded shadow-sm"
                                             style="max-height:250px; object-fit:cover; width:100%;" />
                                    </div>
                                }

                                <!-- Package Video Button -->
                                @if (!string.IsNullOrEmpty(package.VedioUrl) && User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Coach))
                                {
                                    <div class="mb-3 text-center">
                                        <a href="@package.VedioUrl" target="_blank" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-play-circle me-1"></i> Watch Video
                                        </a>
                                    </div>
                                }



                                <!-- Caption -->
                                <div class="properties__caption text-center">
                                    <h5 class="fw-bold text-white">@package.Title</h5>
                                    <span class="month">@package.DurationInMonths month@(package.DurationInMonths > 1 ? "s" : "")</span>
                                    <p class="mb-25 fs-4 fw-bold text-warning">
                                        L.E @package.Price <span class="text-muted">(per month)</span>
                                    </p>

                                    <!-- Description List -->
                                    @if (!string.IsNullOrEmpty(package.Description))
                                    {
                                        var descriptionItems = package.Description.Split('-').Select(s => s.Trim()).ToList();
                                        foreach (var item in descriptionItems)
                                        {
                                            if (string.IsNullOrWhiteSpace(item)) { continue; }
                                            <div class="single-features d-flex align-items-start mb-2">
                                                <div class="features-icon me-2">
                                                    <img src="~/assets/img/icon/check.svg" alt="check" />
                                                </div>
                                                <div class="features-caption text-start">
                                                    <p class="mb-0">@item</p>
                                                </div>
                                            </div>
                                        }
                                    }

                                    <!-- Buttons -->
                                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole(AppRoles.Client))
                                    {
                                        <a href="@Url.Action("ConfirmRequest", "CoachingPackageRequests", new { packageId = package.Id })"
                                           class="border-btn border-btn2">Join Now</a>
                                    }
                                    else if (!User.Identity!.IsAuthenticated)
                                    {
                                        <a href="~/Identity/Account/Login" class="border-btn border-btn2">Join Now</a>
                                    }

                                    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Coach))
                                    {
                                        <div class="d-flex justify-content-center gap-2 mt-3">
                                            <a class="btn btn-outline-info btn-sm" asp-action="Details" asp-route-id="@package.Id">Details</a>
                                            <a class="btn btn-outline-warning btn-sm" asp-action="Edit" asp-route-id="@package.Id">Edit</a>
                                            <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@package.Id">Delete</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center" role="alert">
                        <h4 class="alert-heading">No packages available!</h4>
                        <p>There are no coaching packages listed at the moment. Please check back later.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
