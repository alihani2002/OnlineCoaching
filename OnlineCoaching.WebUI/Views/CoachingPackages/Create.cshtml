@model OnlineCoaching.Domain.Dtos.CreateCoachingPackageDto

@{
    ViewData["Title"] = "Create Coaching Package";
}

<div class="container py-5" style="max-width: 700px;">
    <div class="card shadow-lg rounded-4 border-0">
        <div class="card-header bg-primary text-white text-center py-4">
            <h3 class="fw-bold mb-0">Create New Coaching Package</h3>
        </div>
        <div class="card-body p-4">
            <!-- Added enctype for file upload -->
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-12 mb-4">
                        <div class="form-floating">
                            <input asp-for="Title" class="form-control" placeholder="Package Title" required />
                            <label asp-for="Title">Package Title</label>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-12 mb-4">
                        <div class="form-floating">
                            <textarea asp-for="Description" class="form-control" placeholder="Package Description" style="height: 150px" required></textarea>
                            <label asp-for="Description">Description</label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <div class="form-floating">
                            <input asp-for="DurationInMonths" class="form-control" type="number" placeholder="Duration" required />
                            <label asp-for="DurationInMonths">Duration (in months)</label>
                            <span asp-validation-for="DurationInMonths" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <div class="form-floating">
                            <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="Price" required />
                            <label asp-for="Price">Price</label>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Image Upload -->
                    <div class="col-md-12 mb-4">
                        <label for="ImageUrl" class="form-label fw-bold">Upload Package Image</label>
                        <input type="file" name="ImageUrl" class="form-control" accept="image/*" required />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <!-- Video URL -->
                    <div class="col-md-12 mb-4">
                        <div class="form-floating">
                            <input asp-for="VedioUrl" class="form-control" placeholder="Video URL (optional)" />
                            <label asp-for="VedioUrl">Video URL (optional)</label>
                            <span asp-validation-for="VedioUrl" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
