@model OnlineCoaching.Domain.Dtos.CreateCoachingPackageDto

@{
    ViewData["Title"] = "Create Coaching Package";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header text-white text-center py-3" style="background-color:#FF0000 ">
                    <h3 class="mb-0 text-white">@ViewData["Title"]</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Title" class="form-control" placeholder="Package Title" />
                            <label asp-for="Title"></label>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea asp-for="Description" class="form-control" placeholder="Package Description" style="height: 120px"></textarea>
                            <label asp-for="Description"></label>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="DurationInMonths" class="form-control" type="number" placeholder="Duration" />
                                    <label asp-for="DurationInMonths"></label>
                                    <span asp-validation-for="DurationInMonths" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="Price" />
                                    <label asp-for="Price"></label>
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a class="btn btn-outline-secondary px-4" asp-action="Index">Cancel</a>
                            <button type="submit" class="btn btn-success px-4">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
