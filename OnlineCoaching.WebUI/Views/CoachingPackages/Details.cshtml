@model OnlineCoaching.Domain.Dtos.CoachingPackageDto

@{
    ViewData["Title"] = "Package Details";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="fw-bold mb-4 text-dark">Package Details</h2>

            <dl class="row">
                <dt class="col-sm-3 fw-bold">Package Name</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3 fw-bold">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3 fw-bold">Duration</dt>
                <dd class="col-sm-9">@Model.DurationInMonths month@(Model.DurationInMonths > 1 ? "s" : "")</dd>

                <dt class="col-sm-3 fw-bold">Price</dt>
                <dd class="col-sm-9">L.E @Model.Price.ToString("F2")</dd>

                <dt class="col-sm-3 fw-bold">Created On</dt>
                <dd class="col-sm-9">@Model.CreatedOn.ToString("dd/MM/yyyy hh:mm tt")</dd>

                <dt class="col-sm-3 fw-bold">Last Updated</dt>
                <dd class="col-sm-9">@(Model.LastUpdatedOn?.ToString("dd/MM/yyyy hh:mm tt") ?? "N/A")</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-primary px-4" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="bi bi-pencil-square me-1"></i> Edit
        </a>
        @if (Model.IsFreePlan)
        {
            <a class="btn btn-secondary px-4" asp-action="GetFreePackage">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to List
            </a>
        }
        else
        {
            <a class="btn btn-secondary px-4" asp-action="Index">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to List
            </a>
        }
       
    </div>
</div>