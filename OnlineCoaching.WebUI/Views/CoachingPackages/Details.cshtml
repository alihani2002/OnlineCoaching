@model OnlineCoaching.Domain.Dtos.CoachingPackageDto

@{
    ViewData["Title"] = "Package Details";
}

<h2>@ViewData["Title"]</h2>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text"><strong>Description:</strong> @Model.Description</p>
        <p class="card-text"><strong>Duration:</strong> @Model.DurationInMonths months</p>
        <p class="card-text"><strong>Price:</strong> @Model.Price.ToString("C")</p>
        <p class="card-text"><strong>Created On:</strong> @Model.CreatedOn.ToString("dd/MM/yyyy")</p>
        <p class="card-text"><strong>Last Updated:</strong> @(Model.LastUpdatedOn?.ToString("dd/MM/yyyy") ?? "-")</p>

        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-secondary" asp-action="Index">Back to List</a>
    </div>
</div>
