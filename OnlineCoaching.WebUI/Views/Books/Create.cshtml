@model OnlineCoaching.Domain.Dtos.CreateBookDto

@{
    ViewData["Title"] = "Create Book";
}

<h2>Create Book</h2>

<form asp-action="Create" enctype="multipart/form-data" method="post">
    <div class="form-group">
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Author" class="control-label"></label>
        <input asp-for="Author" class="form-control" />
        <span asp-validation-for="Author" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Upload Full Book (PDF)</label>
        <input type="file" name="file" class="form-control" accept="application/pdf" />
    </div>

    <div class="form-group">
        <label>Upload Demo (PDF)</label>
        <input type="file" name="demoFile" class="form-control" accept="application/pdf" />
    </div>

    <div class="form-group form-check">
        <input asp-for="HasDemo" class="form-check-input" />
        <label asp-for="HasDemo" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
