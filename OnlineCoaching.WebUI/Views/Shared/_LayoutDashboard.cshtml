@using Microsoft.AspNetCore.Identity
@using OnlineCoaching.Infrastructure.Persistence
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
	var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
	ViewData["Title"] = ViewData["Title"] ?? "Dashboard"; // Ensure a default title
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Admin Dashboard</title>

	<link rel="icon" type="image/jpeg" href="~/images/logo/QariFavIcon.png" />
	<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
	<link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">

	<link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />

	<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500&display=swap" rel="stylesheet" />

</head>
<body>
	<div class="container-fluid">
		<div class="row g-0">
			<div class="col-md-2 dashboard-sidebar">
				<button class="btn d-md-none sidebar-toggle-btn" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu">
					<i class="fa-solid fa-bars"></i>
				</button>

				<div class="collapse d-md-block" id="sidebarMenu">
					<div class="d-flex flex-column flex-shrink-0 p-3 sidebar-content">
						<a href="/" class="d-flex align-items-center mb-3 text-decoration-none sidebar-logo-link">
							<div class="footer-logo mb-3">
								<a asp-controller="Home" asp-action="Index" class="logo-text"> Dashboard </a>
							</div>
						</a>
						<hr class="sidebar-divider">
						<ul class="nav nav-pills flex-column mb-auto">
							<li class="nav-item"><a asp-controller="CoachingPackageRequests" asp-action="Index" class="nav-link link-dark"><i class="fas fa-inbox"></i> Requests of Coaching</a></li>
							<li class="nav-item"><a asp-controller="Cooking" asp-action="Index" class="nav-link link-dark"><i class="fas fa-utensils"></i> Cooking</a></li>
							<li class="nav-item"><a asp-controller="Gallery" asp-action="Index" class="nav-link link-dark"><i class="fas fa-images"></i> Images</a></li>
							<li class="nav-item"><a asp-controller="Transformation" asp-action="Index" class="nav-link link-dark"><i class="fas fa-dumbbell"></i> Transformation</a></li>
							<li class="nav-item"><a asp-controller="Clients" asp-action="Index" class="nav-link link-dark"><i class="fas fa-users"></i> User Table</a></li>
							<li class="nav-item"><a asp-controller="CoachingPackages" asp-action="Index" class="nav-link link-dark"><i class="fas fa-box"></i> Add Coaching Package</a></li>
							<li class="nav-item"><a asp-controller="Exercises" asp-action="Index" class="nav-link link-dark"><i class="fas fa-running"></i> Add Exercises</a></li>
							<li class="nav-item"><a asp-controller="Muscles" asp-action="Index" class="nav-link link-dark"><i class="fas fa-fire-alt"></i> Add Muscles</a></li>
							<li class="nav-item"><a asp-controller="Food" asp-action="Index" class="nav-link link-dark"><i class="fas fa-carrot"></i> Add Food</a></li>
							<li class="nav-item"><a asp-controller="Question" asp-action="Index" class="nav-link link-dark"><i class="fas fa-question-circle"></i> Add Question</a></li>
							<li class="nav-item"><a asp-controller="User" asp-action="AdminRegister" class="nav-link link-dark"><i class="fas fa-user-plus"></i> Add Admin</a></li>
						</ul>
						<div class="dropdown mt-auto user-dropdown-container">
							<a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle user-info" data-bs-toggle="dropdown">
								<img src="~/assets/img/logo/noimage.jpg" alt="User" width="32" height="32" class="rounded-circle me-2">
								<strong>
									@UserManager.GetUserName(User)
								</strong>
							</a>
							<ul class="dropdown-menu shadow">
								<li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">⚙ Settings</a></li>
								<li><hr class="dropdown-divider"></li>
								<li>
									<form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
										<button type="submit" class="dropdown-item">🚪 Logout</button>
									</form>
								</li>
							</ul>
						</div>
						<hr class="sidebar-divider">
					</div>
				</div>
			</div>

			<div class="col-md-10" id="mainContent">

				<header class="dashboard-header">
					<div class="d-flex justify-content-between align-items-center w-100">
						<h3 class="dashboard-title">@ViewData["Title"]</h3>
						<div class="d-flex align-items-center header-right">
							<div class="input-group search-bar">
								<input type="text" class="form-control" placeholder="Search...">
								<button class="btn btn-outline-secondary" type="button"><i class="fas fa-search"></i></button>
							</div>
							<a href="#" class="header-icon-link ms-3"><i class="fas fa-bell"></i></a>
							<a href="#" class="header-icon-link ms-3"><i class="fas fa-envelope"></i></a>
						</div>
					</div>
				</header>

				<main class="dashboard-body">
					@RenderBody()
				</main>

				<footer class="dashboard-footer">
					<div class="container-fluid text-center">
						<div class="footer-logo mb-3">
							<a asp-controller="Clients" asp-action="Index" class="logo-text">
								<img src="~/assets/img/logo/logobadr.JPG" alt="Logo" class="footer-logo-img">
							</a>
						</div>
						<div class="footer-social mb-3">
							<a href="#"><i class="fab fa-twitter"></i></a>
							<a href="#"><i class="fab fa-facebook-f"></i></a>
							<a href="#"><i class="fab fa-pinterest-p"></i></a>
						</div>
						<div class="footer-bottom">
							<p>
								Copyright AlDevs &copy;<script>document.write(new Date().getFullYear());</script>
								All rights reserved | Alyhani
							</p>
						</div>
					</div>
				</footer>
			</div>
		</div>
	</div>


	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
	@RenderSection("Scripts", required: false)
</body>
</html>