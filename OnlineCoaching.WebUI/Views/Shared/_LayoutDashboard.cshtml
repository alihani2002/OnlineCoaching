@using Microsoft.AspNetCore.Identity
@using OnlineCoaching.Infrastructure.Persistence
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    ViewData["Title"] = ViewData["Title"] ?? "Dashboard"; // Default title
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link rel="icon" type="image/jpeg" href="~/images/logo/QariFavIcon.png" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
</head>
<body class="dashboard-wrapper">
    <div class="dashboard-sidebar collapse d-md-block" id="sidebarMenu">
        <partial name="_DashboardSidebar" />
    </div>

    <div id="mainContent">
        <button class="btn d-md-none sidebar-toggle-btn" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-expanded="false" aria-controls="sidebarMenu">
            <i class="fa-solid fa-bars"></i>
        </button>

        <header class="dashboard-header">
            <div class="d-flex justify-content-between align-items-center w-100">
                <h3 class="dashboard-title">@ViewData["Title"]</h3>

                <div class="d-flex align-items-center header-right">
                   

                    <div class="dropdown user-dropdown-container">
                        <a href="#"
                           class="d-flex align-items-center text-decoration-none dropdown-toggle user-info"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <img src="~/assets/img/logo/noimage.jpg" alt="User" width="32" height="32" class="rounded-circle me-2">
                            <strong class="text-truncate">@UserManager.GetUserName(User)</strong>
                        </a>
                        <ul class="dropdown-menu shadow">
                            <li>
                                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                    <i class="fas fa-cog me-2"></i> Settings
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout"
                                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="dropdown-item">
                                        <i class="fas fa-sign-out-alt me-2"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <main class="dashboard-body">
            @RenderBody()
        </main>

        <footer class="dashboard-footer">
            <div class="container-fluid text-center">
                <div class="footer-logo mb-3">
                    <a asp-controller="Home" asp-action="Index" class="logo-text">
                        <img src="~/assets/img/logo/logobadr.JPG" alt="Logo" class="footer-logo-img">
                    </a>
                </div>
                <div class="footer-social mb-3">
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-pinterest-p"></i></a>
                </div>
                <div class="footer-bottom">
                    <p>
                        &copy; AlDevs <script>document.write(new Date().getFullYear());</script>
                        | All rights reserved | Alyhani
                    </p>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // Simple logic to ensure the sidebar collapses on item click for mobile
        $(document).ready(function () {
            $('.nav-link').on('click', function () {
                if ($(window).width() < 768) {
                    $('#sidebarMenu').collapse('hide');
                }
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>