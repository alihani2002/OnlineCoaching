@using Microsoft.AspNetCore.Identity
@using OnlineCoaching.Infrastructure.Persistence
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

    <style>
    .username-text {
        color: #fff;
        font-weight: 600;
        font-size: 14px;
    }
    @@media (max-width: 988px) {
    a.btn.btn-outline-dark.btn-sm
    {
        padding: inherit;
        color:white;
    }
    }
    </style>
<header>
    <div class="header-area header-transparent">
        <div class="main-header header-sticky">
            <div class="container-fluid">
                <div class="logo">
                    <a asp-controller="Home" asp-action="Index" class="logo-text mt-3">
                       Coach BadrReda 
                    </a>
                </div>
                <div class="menu-wrapper d-flex align-items-center justify-content-between">
                    <!-- Logo -->
                  

                    <!-- Main-menu -->
                    <div class="main-menu  d-none d-lg-block">
                        <nav>
                            <ul id="navigation">
                                <li><a asp-controller="Home" asp-action="Index">Home</a></li>

                                @* Show menu items depending on role *@
                                @if (User.IsInRole(AppRoles.Client))
                                {
                                    <li><a asp-controller="Clients" asp-action="Profile">Profile</a></li>
                                    <li><a asp-controller="CoachingPackages" asp-action="GetCoachingPackage">CoachPackages</a></li>
                                    <li><a asp-controller="Transformation" asp-action="ImageGallery">Transformations</a></li>
                                    <li><a asp-controller="Food" asp-action="Compare">Compare</a></li>
                                    <li><a asp-controller="Gallery" asp-action="Galleries">Gallery</a></li>

                                }
                                else if (User.IsInRole(AppRoles.Coach))
                                {
                                    <li><a asp-controller="Clients" asp-action="Index">Users</a></li>
                                    <li><a asp-controller="CoachingPackages" asp-action="Index">CoachPackages</a></li>
                                }
                                else
                                {
                                    <li><a asp-controller="CoachingPackages" asp-action="Index">CoachPackages</a></li>
                                    <li><a asp-controller="Transformation" asp-action="ImageGallery">Transformations</a></li>
                                    <li><a asp-controller="Food" asp-action="Compare">Compare</a></li>
                                    <li><a asp-controller="Gallery" asp-action="Galleries">Gallery</a></li>
                                }
                                @if (SignInManager.IsSignedIn(User))
                                {
                                    <li  class="username-text me-2">
                                        Hello, @UserManager.GetUserName(User)
                                    </li>
                                    <form asp-area="Identity" asp-page="/Account/Logout"
                                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                          method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-dark btn-sm">Logout</button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-dark btn-sm">Login</a>
                                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-dark btn-sm">Register</a>
                                }
                            </ul>
                        </nav>
                    </div>

                    <div class="col-12">
                        <div class="mobile_menu d-block d-lg-none"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
