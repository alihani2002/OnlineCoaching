@{
    Layout = null; // Use your layout if you want header/footer, else keep it null for full-page
    ViewData["Title"] = "Page Not Found";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My Website</title>

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #0b0b0b;
            font-family: Arial, sans-serif;
            color: #fff;
            overflow: hidden;
        }

        .container {
            text-align: center;
            position: relative;
            z-index: 10;
        }

            .container h1 {
                font-size: clamp(3rem, 8vw, 6rem);
                margin: 0;
                color: #f44336;
            }

            .container h2 {
                font-size: clamp(1.5rem, 5vw, 2.5rem);
                margin: 10px 0 20px;
                color: #ccc;
            }

            .container p {
                color: #aaa;
                font-size: 1rem;
            }

            .container a {
                display: inline-block;
                margin-top: 20px;
                padding: 12px 25px;
                background: #f44336;
                color: #fff;
                text-decoration: none;
                border-radius: 6px;
                transition: 0.3s;
            }

                .container a:hover {
                    background: #d32f2f;
                }

        /* Stars background */
        .starry-sky {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            overflow: hidden;
        }

        .star {
            position: absolute;
            width: 2px;
            height: 2px;
            background: white;
            border-radius: 50%;
            animation: twinkle 3s infinite alternate;
        }

        @@keyframes twinkle {
            from

        {
            opacity: 0.3;
        }

        to {
            opacity: 1;
        }

        }

        /* Floating moon */
        .moon {
            position: absolute;
            top: 10%;
            right: 15%;
            width: 80px;
            height: 80px;
            background: #ddd;
            border-radius: 50%;
            box-shadow: 0 0 20px #fff;
            animation: float 6s ease-in-out infinite;
        }

        @@keyframes float {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-20px);
        }

        }
    </style>
</head>
<body>
    <div class="starry-sky">
        @* Generate some random stars *@
        @for (int i = 0; i < 50; i++)
        {
            var left = new Random().Next(0, 100);
            var top = new Random().Next(0, 100);
            <div class="star" style="left:@left%; top:@top%"></div>
        }
        <div class="moon"></div>
    </div>

    <div class="container">
        <h1>404</h1>
        <h2>Oops! Page not found</h2>
        <p>The page you are looking for doesn’t exist or was moved.</p>
        <a href="@Url.Action("Index", "Home")">Back to Home</a>
    </div>
</body>
</html>
