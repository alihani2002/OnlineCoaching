@model OnlineCoaching.Domain.Entities.Transformation

@{
    ViewData["Title"] = "Add Transformation";
}

<div class="container mt-4">
    <h2 class="mb-4">Add New Transformation</h2>

    <form asp-action="Create" enctype="multipart/form-data" method="post" class="row g-3">
        <div class="col-md-6">
            <label asp-for="ClientId" class="form-label">Client</label>
            <select asp-for="ClientId" class="form-select"
                    asp-items="@(ViewBag.Clients != null ? new SelectList(ViewBag.Clients, "Id", "FullName") : new SelectList(new List<OnlineCoaching.Domain.Entities.Client>()))">
                <option value="">-- Select Client --</option>
            </select>
            <span asp-validation-for="ClientId" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Titles" class="form-label">Title</label>
            <input asp-for="Titles" class="form-control" placeholder="Enter title..." />
            <span asp-validation-for="Titles" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Notes" class="form-label">Notes</label>
            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Enter notes..."></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Before Image</label>
            <input type="file" name="beforeImage" class="form-control" />
            @if (!string.IsNullOrEmpty(Model?.BeforeImageUrl))
            {
                <div class="mt-2">
                    <img src="@Model.BeforeImageUrl" class="img-thumbnail" width="150" />
                </div>
            }
        </div>

        <div class="col-md-6">
            <label class="form-label">After Image</label>
            <input type="file" name="afterImage" class="form-control" />
            @if (!string.IsNullOrEmpty(Model?.AfterImageUrl))
            {
                <div class="mt-2">
                    <img src="@Model.AfterImageUrl" class="img-thumbnail" width="150" />
                </div>
            }
        </div>

        <div class="col-12 d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
