@model Transformation

@{
    ViewData["Title"] = "Edit Transformation";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="card shadow-lg rounded-4 border-0">
        <div class="card-header bg-dark text-white text-center py-4">
            <h3 class="fw-bold mb-0">Edit Transformation</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" enctype="multipart/form-data" method="post" class="row g-4">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="BeforeImageUrl" />
                <input type="hidden" asp-for="AfterImageUrl" />

                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="ClientId" class="form-select" id="clientSelect" required
                                asp-items="@(ViewBag.Clients != null
                                                                    ? new SelectList(ViewBag.Clients, "Id", "FullName", Model.ClientId)
                                                                    : new SelectList(new List<OnlineCoaching.Domain.Entities.Client>()))">
                            <option value="">-- Select Client --</option>
                        </select>
                        <label for="clientSelect">Client</label>
                        <span asp-validation-for="ClientId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Titles" class="form-control" placeholder="Transformation Title" required />
                        <label asp-for="Titles">Title</label>
                        <span asp-validation-for="Titles" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-floating">
                        <textarea asp-for="Notes" class="form-control" placeholder="Notes" style="height: 120px;"></textarea>
                        <label asp-for="Notes">Notes</label>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-4 mt-2">
                    <div class="col-md-6">
                        <label for="beforeImage" class="form-label d-block mb-2">Before Image</label>
                        <input type="file" name="beforeImage" id="beforeImage" class="form-control" />
                        @if (!string.IsNullOrEmpty(Model.BeforeImageUrl))
                        {
                            <div class="mt-3 text-center">
                                <img src="@Model.BeforeImageUrl" class="img-thumbnail rounded shadow-sm" alt="Before Image" style="max-width:200px; height:auto;" />
                                <p class="small text-muted mt-1">Current Image</p>
                            </div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label for="afterImage" class="form-label d-block mb-2">After Image</label>
                        <input type="file" name="afterImage" id="afterImage" class="form-control" />
                        @if (!string.IsNullOrEmpty(Model.AfterImageUrl))
                        {
                            <div class="mt-3 text-center">
                                <img src="@Model.AfterImageUrl" class="img-thumbnail rounded shadow-sm" alt="After Image" style="max-width:200px; height:auto;" />
                                <p class="small text-muted mt-1">Current Image</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2 mt-5">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}