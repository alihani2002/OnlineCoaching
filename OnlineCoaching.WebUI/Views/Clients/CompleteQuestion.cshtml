@model IEnumerable<Question>

@{
    ViewData["Title"] = "Complete Your Questions";
}

<div class="container py-5">
    <div class="card shadow-lg border-0" style="border-radius: 18px; overflow: hidden;">
        <div class="card-header text-white text-center" style="background: linear-gradient(90deg, #bec2c6, #962121);">
            <h3 class="mb-0 fw-bold text-white">📝 Answer the Questions</h3>
        </div>
        <div class="card-body" style="background-color: #f9f9fb;">
            <form asp-action="CompleteQuestion" method="post">
                <div id="questionList">
                    @{
                        var sortedQuestions = Model.OrderBy(q => q.NumberOfQuestion).ToList();
                    }

                    @for (int i = 0; i < sortedQuestions.Count; i++)
                    {
                        var question = sortedQuestions[i];
                        var isArabic = System.Text.RegularExpressions.Regex.IsMatch(question.Text, @"\p{IsArabic}");

                        <div class="mb-5 question-item">
                            <div class="card shadow-sm border-0 h-100" style="border-radius: 16px; background: #ffffff;">
                                <div class="card-body p-4 text-dark" dir="@(isArabic ? "rtl" : "ltr")">
                                    <h5 class="card-title fw-bold mb-3 text-dark d-flex align-items-center">
                                        <span class="question-number me-2">@(i + 1) - </span>
                                        <span> @question.Text</span>
                                    </h5>

                                    <input type="hidden" name="answers[@i].QuestionId" value="@question.Id" />

                                    @if (question.Type == QuestionType.SingleChoice)
                                    {
                                        foreach (var option in question.Options!)
                                        {
                                            <div class="form-check option-item mb-2">
                                                <input class="form-check-input styled-check"
                                                       type="radio"
                                                       name="answers[@i].SelectedOptions[0].OptionId"
                                                       value="@option.Id"
                                                       id="option-@option.Id-@i" />
                                                <label class="form-check-label text-dark fw-semibold" for="option-@option.Id-@i">
                                                    @option.Text
                                                </label>
                                            </div>
                                        }
                                    }
                                    else if (question.Type == QuestionType.MultipleChoice)
                                    {
                                        var optionsList = question.Options!.ToList();
                                        for (int j = 0; j < optionsList.Count; j++)
                                        {
                                            var option = optionsList[j];
                                            <div class="form-check option-item mb-2">
                                                <input class="form-check-input styled-check"
                                                       type="checkbox"
                                                       name="answers[@i].SelectedOptions[@j].OptionId"
                                                       value="@option.Id"
                                                       id="option-@option.Id-@i-@j" />
                                                <label class="form-check-label text-dark fw-semibold" for="option-@option.Id-@i-@j">
                                                    @option.Text
                                                </label>
                                            </div>
                                        }
                                    }
                                    else if (question.Type == QuestionType.OpenText)
                                    {
                                        <textarea name="answers[@i].AnswerText"
                                          class="form-control mt-2 text-dark"
                                          rows="3"
                                          placeholder="✍️ اكتب إجابتك هنا..."
                                          dir="@(isArabic ? "rtl" : "ltr")"></textarea>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-lg px-5 text-white fw-bold" style="background: linear-gradient(90deg,#007bff,#6610f2); border-radius: 50px;">
                        🚀 Submit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* يجعل حدود الـ checkbox والـ radio سوداء */
    .styled-check[type="checkbox"],
    .styled-check[type="radio"] {
        border: 2px solid #000 !important; /* أسود */
        accent-color: #000 !important; /* يجعل الصح/النقطة سوداء */
        width: 18px;
        height: 18px;
        cursor: pointer;
    }
    /* ======== Custom Checkboxes / Radios ======== */
    .styled-check {
        accent-color: #000000 !important; /* يجعل الصح أسود واضح */
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    /* تحسين عرض النصوص */
    .form-check-label {
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-block;
        padding: 8px 12px;
        border-radius: 8px;
    }

    .option-item:hover .form-check-label {
        background-color: #f1f3f6;
    }

    .option-selected .form-check-label {
        background: linear-gradient(90deg, #79af7f, #30a642);
        color: #fff !important;
        font-weight: bold;
    }

    .form-control {
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 12px;
        transition: border 0.3s;
    }

        .form-control:focus {
            border-color: #6610f2;
            box-shadow: 0px 0px 6px rgba(102,16,242,0.3);
        }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            function scrollToNext(currentIndex) {
                const next = $('.question-item').eq(currentIndex + 1);
                if (next.length) {
                    $('html, body').animate({
                        scrollTop: next.offset().top - 166
                    }, 600);
                }
            }

            $('.question-item').each(function (index) {
                const $item = $(this);

                // Radios
                $item.find('input[type="radio"]').on('change', function () {
                    const groupName = $(this).attr('name');
                    $('input[name="' + groupName + '"]').each(function () {
                        $(this).closest('.form-check').removeClass('option-selected');
                    });
                    $(this).closest('.form-check').addClass('option-selected');
                    scrollToNext(index);
                });

                // Checkboxes
                $item.find('input[type="checkbox"]').on('change', function () {
                    $(this).closest('.form-check').toggleClass('option-selected', this.checked);
                });

                // Text input
                $item.find('textarea').on('input', function () {
                    if ($(this).val().trim().length > 2) {
                        scrollToNext(index);
                    }
                });
            });
        });
    </script>
}
