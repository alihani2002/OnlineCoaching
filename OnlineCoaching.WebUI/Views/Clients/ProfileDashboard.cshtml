@using OnlineCoaching.Domain.Dtos.AssignmentCoaching
@using OnlineCoaching.WebUI.Models.Clients
@model ClientDashboardViewModel

<body>
    <link rel="stylesheet" href="~/assets/css/profile.css" />

    <!-- ================== PROFILE SECTION ================== -->
    <div class="container py-5">
        @if (Model != null)
        {
            <div class="profile-card shadow-lg">
                <div class="profile-header text-center">
                    <img src="~/assets/img/logo/unknown.png" alt="Profile Picture" class="profile-avatar" />
                    <h3 class="mt-3">@Model.Client.FullName</h3>
                    <p class="text-white">👤 Client Profile</p>
                </div>

                <div class="profile-details mt-4">
                    <table class="table-profile">
                        <tr>
                            <th><i class="fas fa-user"></i> Full Name</th>
                            <td>@Model.Client.FullName</td>
                        </tr>
                        <tr>
                            <th><i class="fas fa-birthday-cake"></i> Birth Date</th>
                            <td>@Model.Client.BirthDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                        <tr>
                            <th><i class="fas fa-phone"></i> Phone</th>
                            <td>@Model.Client.WhatsUpNumber</td>
                        </tr>
                        <tr>
                            <th><i class="fas fa-map-marker-alt"></i> Address</th>
                            <td>@Model.Client.Address</td>
                        </tr>
                        <tr>
                            <th><i class="fas fa-id-card"></i> National ID</th>
                            <td>@Model.Client.NationalId</td>
                        </tr>
                    </table>
                </div>
                <div class="text-center mt-4">
                    <a asp-controller="Clients" asp-action="Edit" asp-route-id="@Model!.Client.Id"
                       class="btn btn-lg btn-danger shadow edit-profile-btn">
                        ✏️ Edit Profile
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Coach"))
                    {
                        <div class="mt-4 d-flex flex-column flex-sm-row justify-content-center gap-3">
                            <a asp-controller="Exercises" asp-action="Assign" asp-route-clientId="@Model.Client.Id" class="btn btn-lg btn-danger shadow edit-profile-btn">
                                ➕ Assign Foods / Exercises
                            </a>
                            <a asp-controller="Exercises" asp-action="AssignedList" asp-route-clientId="@Model.Client.Id" class="btn btn-lg btn-danger shadow edit-profile-btn">
                                📋 View Assigned Items
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
        else if (User.IsInRole(AppRoles.Admin))
        {
            <div class="custom-card text-center">
                <h3 class="text-danger">⚡ Welcome to Admin Dashboard</h3>
            </div>
        }
        else
        {
            <div class="custom-card text-center">
                <p>No profile data available.</p>
            </div>
        }
    </div>

    <!-- ================== QUESTIONS SECTION ================== -->
    @if (Model!.Questions.Any())
    {
        <div class="slider-area2">
            <div class="slider-height2 d-flex align-items-center">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="hero-cap hero-cap2 pt-70">
                                <h2>Answered Questions</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            @foreach (var question in Model.Questions)
            {
                var answer = Model.Answers.FirstOrDefault(a => a.QuestionId == question.Id);

                <div class="qa-card d-flex flex-column flex-md-row align-items-stretch mb-4 p-3">
                    <!-- السؤال -->
                    <div class="qa-question flex-fill text-md-end text-center p-3">
                        <h5 class="fw-bold text-warning mb-2">
                            @(question.NumberOfQuestion). @question.Text
                        </h5>
                    </div>

                    <!-- الإجابة -->
                    <div class="qa-answer flex-fill text-md-start text-center p-3">
                        @if (question.Type == QuestionType.OpenText)
                        {
                            <p class="text-light">@((answer?.AnswerText) ?? "No answer provided")</p>
                        }
                        else if (question.Type == QuestionType.SingleChoice)
                        {
                            <p class="text-light">@((answer?.SelectedOptions.FirstOrDefault()?.Option?.Text) ?? "No option selected")</p>
                        }
                        else if (question.Type == QuestionType.MultipleChoice)
                        {
                            if (answer?.SelectedOptions?.Any() == true)
                            {
                                <ul class="list-unstyled text-light">
                                    @foreach (var opt in answer.SelectedOptions)
                                    {
                                        <li>✔ @opt.Option!.Text</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">No options selected</span>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- ================== EXERCISES & FOODS ================== -->
    <div class="container">
        <div class="slider-area2">
            <div class="slider-height2 d-flex align-items-center">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="hero-cap hero-cap2 pt-70">
                                <h2>Exercises</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="exercise-container"></div>

        <div class="slider-area2">
            <div class="slider-height2 d-flex align-items-center">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="hero-cap hero-cap2 pt-70">
                                <h2>Nutrition Plan</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="food-container"></div>
    </div>

    <!-- Inject JSON into window object -->
    <script>
        window.assignedExercises = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model!.AssignedExercises ?? new List<AssignExerciseDto>()))');
        window.assignedFoods = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AssignedFoods ?? new List<AssignFoodDto>()))');
        window.clientId = '@Model.Client.Id';
    </script>
    <script src="~/assets/js/ProfileDashboard.js" asp-append-version="true"></script>
</body>
