@model OnlineCoaching.Domain.Entities.Client
@{
    ViewData["Title"] = "Edit Client";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header  text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Client</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @* Validation Summary *@
                        <div asp-validation-summary="All" type="hidden" class="alert alert-danger mb-4" role="alert"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BirthDate" class="form-label fw-bold"></label>
                            <input asp-for="BirthDate" type="date" class="form-control" />
                            <span asp-validation-for="BirthDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="WhatsUpNumber" class="form-label fw-bold"></label>
                            <input asp-for="WhatsUpNumber" class="form-control" placeholder="Enter WhatsApp number" />
                            <span asp-validation-for="WhatsUpNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold"></label>
                            <input asp-for="Address" class="form-control" placeholder="Enter address" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NationalId" class="form-label fw-bold"></label>
                            <input asp-for="NationalId" class="form-control" placeholder="Enter national ID" />
                            <span asp-validation-for="NationalId" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Profile" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left-circle me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
