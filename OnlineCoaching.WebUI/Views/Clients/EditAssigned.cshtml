@using OnlineCoaching.Domain.Enums.DayOfWeek
@using OnlineCoaching.WebUI.Models.RequestPackage
@using OnlineCoaching.Domain.Enums
@model AssignedListViewModel

@{
    ViewData["Title"] = "Edit Assigned Exercises & Foods";
}

<h2 class="mb-4">Edit Assigned Exercises & Foods</h2>

<!-- Main Edit Form -->
<form asp-action="EditAssigned" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ClientId" />
    <input type="hidden" asp-for="RequestId" />

    <!-- Exercises Section -->
    <div class="mb-5 p-4 border rounded shadow-sm bg-light">
        <h4 class="mb-3">Exercises</h4>
        <div id="exercise-container">
            @for (int i = 0; i < Model.AssignedExercises!.Count; i++)
            {
                <div class="exercise-item mb-3 p-3 border rounded bg-white">
                    <input type="hidden" name="AssignedExercises[@i].Id" value="@Model.AssignedExercises[i].Id" />

                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <label class="form-label">Day</label>
                            <select name="AssignedExercises[@i].DayOfWeek" class="form-select">
                                @foreach (DayOfWeekEnum day in Enum.GetValues(typeof(DayOfWeekEnum)))
                                {
                                    <option value="@((int)day)" selected="@(day == Model.AssignedExercises[i].DayOfWeek)">
                                        @day
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Exercise</label>
                            <select name="AssignedExercises[@i].ExerciseId" class="form-select">
                                @foreach (var ex in Model.AvailableExercises!)
                                {
                                    <option value="@ex.Id" selected="@(ex.Id == Model.AssignedExercises[i].ExerciseId)">
                                        @ex.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Sets</label>
                            <input name="AssignedExercises[@i].Sets" class="form-control" value="@Model.AssignedExercises[i].Sets" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Reps</label>
                            <input name="AssignedExercises[@i].Reps" class="form-control" value="@Model.AssignedExercises[i].Reps" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Notes</label>
                            <input name="AssignedExercises[@i].Notes" class="form-control" value="@Model.AssignedExercises[i].Notes" />
                        </div>
                    </div>

                    <!-- Delete Button -->
                    <button type="submit"
                            class="btn btn-danger btn-sm mt-3"
                            formaction="@Url.Action("DeleteAssignedExercise", "Clients")"
                            formmethod="post"
                            name="id" value="@Model.AssignedExercises[i].Id"
                            onclick="return confirm('Are you sure you want to delete this exercise?');">
                        Delete
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Foods Section -->
    <div class="mb-5 p-4 border rounded shadow-sm bg-light">
        <h4 class="mb-3">Foods</h4>
        <div id="food-container">
            @for (int i = 0; i < Model.AssignedFoods!.Count; i++)
            {
                <div class="food-item mb-3 p-3 border rounded bg-white">
                    <input type="hidden" name="AssignedFoods[@i].Id" value="@Model.AssignedFoods[i].Id" />

                    <div class="row g-2 align-items-center">
                        <div class="col-md-2">
                            <label class="form-label">Day</label>
                            <select name="AssignedFoods[@i].DayOfWeek" class="form-select">
                                @foreach (DayOfWeekEnum day in Enum.GetValues(typeof(DayOfWeekEnum)))
                                {
                                    <option value="@((int)day)" selected="@(day == Model.AssignedFoods[i].DayOfWeek)">
                                        @day
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Meal</label>
                            <select name="AssignedFoods[@i].MealNumber" class="form-select">
                                @foreach (MealsNum meal in Enum.GetValues(typeof(MealsNum)))
                                {
                                    <option value="@((int)meal)" selected="@(meal == Model.AssignedFoods[i].MealNumber)">
                                        @meal
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Food</label>
                            <select name="AssignedFoods[@i].FoodId" class="form-select">
                                @foreach (var f in Model.AvailableFoods!)
                                {
                                    <option value="@f.Id" selected="@(f.Id == Model.AssignedFoods[i].FoodId)">
                                        @f.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Quantity</label>
                            <input name="AssignedFoods[@i].Quantity" class="form-control" value="@Model.AssignedFoods[i].Quantity" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Servings</label>
                            <input name="AssignedFoods[@i].NumberOfServings" class="form-control" value="@Model.AssignedFoods[i].NumberOfServings" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Notes</label>
                            <input name="AssignedFoods[@i].Notes" class="form-control" value="@Model.AssignedFoods[i].Notes" />
                        </div>
                    </div>

                    <!-- Delete Button -->
                    <button type="submit"
                            class="btn btn-danger btn-sm mt-3"
                            formaction="@Url.Action("DeleteAssignedFood", "Clients")"
                            formmethod="post"
                            name="id" value="@Model.AssignedFoods[i].Id"
                            onclick="return confirm('Are you sure you want to delete this food?');">
                        Delete
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Save Button -->
    <button type="submit" class="btn btn-primary btn-lg w-100">Save Changes</button>
</form>

@section Scripts {
    <script>
        // Optional: Re-index inputs if you dynamically add/remove items
        function reIndex(containerSelector) {
            $(containerSelector).children().each(function (i) {
                $(this).find("select, input").each(function () {
                    var name = $(this).attr("name");
                    if (name) {
                        var newName = name.replace(/\[\d+\]/, `[${i}]`);
                        $(this).attr("name", newName);
                    }
                });
            });
        }
    </script>
}
