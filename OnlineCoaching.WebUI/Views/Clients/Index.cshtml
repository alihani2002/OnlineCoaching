@model Client

@{
    ViewData["Title"] = "Profile";
}

@if (ViewBag.ShowProfilePopup == true)
{
    <style>
        header, .footer-area, .slider-area2 {
            display: none !important;
        }
    </style>

    <!-- Background overlay -->
    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index:1040;background-color:rgba(0,0,0,0.8);"></div>

    <!-- Modal -->
    <div id="profilePopup" class="modal fade show d-block" tabindex="-1" style="z-index:1050;margin-top:10%;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content bg-dark mt-5 text-light border-0 shadow-lg">
                <form asp-action="CompleteProfile" method="post">
                    <input type="hidden" name="UserId" value="@User.FindFirst("sub")?.Value" />

                    <div class="modal-header border-0">
                        <h5 class="modal-title text-danger fw-bold">💪 Complete Your Profile</h5>
                    </div>
                    <div class="modal-body">
                        <div class="form-group mb-3">
                            <label class="form-label text-light">Full Name</label>
                            <input type="text" name="FullName" class="form-control bg-dark text-light border-danger" required />
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label text-light">Birth Date</label>
                            <input type="date" name="BirthDate" class="form-control bg-dark text-light border-danger" required />
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label text-light">Phone Number</label>
                            <input type="text" name="PhoneNumber" class="form-control bg-dark text-light border-danger" />
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label text-light">Address</label>
                            <input type="text" name="Address" class="form-control bg-dark text-light border-danger" />
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="submit" class="btn btn-danger px-4">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model != null)
{
    <section class="section-padding40 fix" style="background-color:#111; min-height:80vh;">
        <div class="container d-flex justify-content-center align-items-center">
            <div class="card shadow-lg mt-5 border-0 rounded-3 bg-dark text-light p-4" style="max-width:700px; width:100%;">
                <h3 class="mb-4 text-center text-danger fw-bold">👤 Your Profile</h3>
                <table class="table table-dark table-striped table-bordered align-middle mb-0">
                    <tr>
                        <th class="text-danger">Full Name</th>
                        <td>@Model.FullName</td>
                    </tr>
                    <tr>
                        <th class="text-danger">Birth Date</th>
                        <td>@Model.BirthDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                    <tr>
                        <th class="text-danger">Phone Number</th>
                        <td>@Model.PhoneNumber</td>
                    </tr>
                    <tr>
                        <th class="text-danger">Address</th>
                        <td>@Model.Address</td>
                    </tr>
                </table>
            </div>
        </div>
    </section>
}
else if (User.IsInRole(AppRoles.Admin))
{
    <section class="section-padding40 fix" style="background-color:#111; min-height:80vh;">
        <div class="container d-flex justify-content-center align-items-center">
            <div class="card shadow-lg p-4 bg-dark text-light rounded text-center border-0" style="max-width:500px; width:100%;">
                <h3 class="mb-0 text-danger">⚡ Welcome to Admin Dashboard</h3>
            </div>
        </div>
    </section>
}
else
{
    <section class="section-padding40 fix" style="background-color:#111; min-height:80vh;">
        <div class="container d-flex justify-content-center align-items-center">
            <div class="card shadow-lg p-4 bg-dark text-light rounded text-center border-0" style="max-width:500px; width:100%;">
                <p class="mb-0">No profile data available.</p>
            </div>
        </div>
    </section>
}
