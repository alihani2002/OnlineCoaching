@model ApplicationUser
@{
    ViewData["Title"] = "Register Admin";
}

<link rel="stylesheet" href="~/css/User-AdminRegister.css" />


<div class="container-fluid">
    <div class="register-card">
        <div class="form-header">
            <h2 class="display-5 fw-bold">
                <i class="fas fa-user-shield me-2 text-primary"></i>
                Create New Admin
            </h2>
            <p class="text-muted">Fill out the form below to register a new administrator.</p>
        </div>

        <form asp-action="AdminRegister" method="post">
            <div asp-validation-summary="All" class="text-danger mb-4"></div>

            <div class="form-group mb-4">
                <label asp-for="FullName" class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control" required />
                <span asp-validation-for="FullName" class="text-danger mt-1"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="UserName" class="form-label">Username</label>
                <input asp-for="UserName" class="form-control" required />
                <span asp-validation-for="UserName" class="text-danger mt-1"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" required />
                <span asp-validation-for="Email" class="text-danger mt-1"></span>
            </div>

            <div class="form-group mb-4">
                <label class="form-label">Password</label>
                <input name="PasswordHash" type="password" class="form-control" required />
            </div>

            <input type="hidden" asp-for="Role" value="Admin" />

            <div class="d-flex justify-content-center gap-3 mt-4">
                <button type="submit" class="btn btn-custom-success">Register Admin</button>
                <a asp-action="Index" class="btn btn-custom-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}