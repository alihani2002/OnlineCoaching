@model OnlineCoaching.Domain.Dtos.CreateExerciseDto

@{
    ViewData["Title"] = "Create Exercise";
}

<div class="container py-5" style="max-width: 800px;">
    <div class="card shadow-lg rounded-4 border-0">
        <div class="card-header bg-primary text-white text-center py-4">
            <h3 class="fw-bold mb-0">Create New Exercise</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g., Bench Press"  required/>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold"></label>
                    <textarea asp-for="Description" class="form-control form-control-lg" rows="4" placeholder="Describe the exercise technique and purpose."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="MuscleId" class="form-label fw-bold">Target Muscle</label>
                        <select asp-for="MuscleId" class="form-control form-control-lg" asp-items="ViewBag.Muscles">
                            <option value="">-- Select Muscle --</option>
                        </select>
                        <span asp-validation-for="MuscleId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="VideoUrl" class="form-label fw-bold">Video URL</label>
                        <input asp-for="VideoUrl" class="form-control form-control-lg" placeholder="e.g., https://youtube.com/..." />
                        <span asp-validation-for="VideoUrl" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="ImageUrl" class="form-label fw-bold">Exercise Image</label>
                    <input type="file" name="ImageUrl" class="form-control form-control-lg" accept="image/*" required />
                    <div class="form-text text-muted">Upload an image for the exercise (optional).</div>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold mb-3">Additional Links</h5>
                    <div id="links-container">
                        <div class="d-flex mb-2">
                            <input type="text" name="LinkUrls" class="form-control form-control-lg me-2" placeholder="Enter link" />
                            <button type="button" class="btn btn-outline-danger" onclick="removeLink(this)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-primary mt-2" onclick="addLink()">
                        <i class="bi bi-plus-circle me-1"></i> Add Link
                    </button>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="bi bi-arrow-left-circle me-1"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function addLink() {
            var container = document.getElementById('links-container');
            var div = document.createElement('div');
            div.classList.add('d-flex', 'mb-2');
            div.innerHTML = `
                <input type="text" name="LinkUrls" class="form-control form-control-lg me-2" placeholder="Enter link URL" />
                <button type="button" class="btn btn-outline-danger" onclick="removeLink(this)">
                    <i class="bi bi-trash"></i>
                </button>
            `;
            container.appendChild(div);
        }

        function removeLink(button) {
            button.parentElement.remove();
        }
    </script>
}