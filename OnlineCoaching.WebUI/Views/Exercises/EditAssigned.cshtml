@using OnlineCoaching.WebUI.Models.RequestPackage
@using OnlineCoaching.Domain.Enums
@model AssignedListViewModel

@{
    ViewData["Title"] = "Edit Assigned Exercises & Foods";
}

<h2 class="mb-4">Edit Assigned Exercises & Foods</h2>

<form asp-action="EditAssigned" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ClientId" />
    <input type="hidden" asp-for="RequestId" />

    <!-- Exercises Section -->
    <div class="mb-5 p-4 border rounded shadow-sm bg-light">
        <h4 class="mb-3">Edit Assigned Exercises</h4>
        <div id="exercise-container">
            @for (int i = 0; i < Model.AssignedExercises!.Count; i++)
            {
                var ex = Model.AssignedExercises[i];
                ex.SelectedDays = ex.SelectedDays ?? new List<int>();

                <div class="exercise-item mb-3 p-3 border rounded bg-white">
                    <input type="hidden" name="AssignedExercises[@i].Id" value="@ex.Id" />
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <label class="form-label">Exercise</label>
                            <select name="AssignedExercises[@i].ExerciseId" class="form-select">
                                @foreach (var available in Model.AvailableExercises!)
                                {
                                    <option value="@available.Id" selected="@(available.Id == ex.ExerciseId)">
                                        @available.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Sets</label>
                            <input name="AssignedExercises[@i].Sets" class="form-control" value="@ex.Sets" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Reps</label>
                            <input name="AssignedExercises[@i].Reps" class="form-control" value="@ex.Reps" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Days</label>
                            <select name="AssignedExercises[@i].SelectedDays" multiple class="form-select">
                                @foreach (DayOfWeekEnum d in Enum.GetValues(typeof(DayOfWeekEnum)))
                                {
                                    var value = (int)d;
                                    var isSelected = ex.SelectedDays.Contains(value) ? "selected" : null;
                                    <option value="@value" selected="@isSelected">@d</option>
                                }
                            </select>
                            <small class="text-muted">Hold Ctrl (Windows) or Cmd (Mac) to select multiple</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Notes</label>
                            <input name="AssignedExercises[@i].Notes" class="form-control" value="@ex.Notes" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-danger remove-exercise">X</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <button type="button" id="add-exercise" class="btn btn-success">Add Exercise</button>
    </div>

    <!-- Foods Section -->
    <div class="mb-5 p-4 border rounded shadow-sm bg-light">
        <h4 class="mb-3">Edit Assigned Foods</h4>
        <div id="food-container">
            @for (int i = 0; i < Model.AssignedFoods!.Count; i++)
            {
                var food = Model.AssignedFoods[i];
                food.SelectedDays = food.SelectedDays ?? new List<int>();

                <div class="food-item mb-3 p-3 border rounded bg-white">
                    <input type="hidden" name="AssignedFoods[@i].Id" value="@food.Id" />
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <label class="form-label">Food</label>
                            <select name="AssignedFoods[@i].FoodId" class="form-select">
                                @foreach (var f in Model.AvailableFoods!)
                                {
                                    <option value="@f.Id" selected="@(f.Id == food.FoodId)">
                                        @f.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Quantity (g/ml)</label>
                            <input name="AssignedFoods[@i].Quantity" class="form-control" value="@food.Quantity" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Servings</label>
                            <input name="AssignedFoods[@i].NumberOfServings" class="form-control" type="number" min="1" value="@food.NumberOfServings" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Days</label>
                            <select name="AssignedFoods[@i].SelectedDays" multiple class="form-select">
                                @foreach (DayOfWeekEnum d in Enum.GetValues(typeof(DayOfWeekEnum)))
                                {
                                    var value = (int)d;
                                    var isSelected = food.SelectedDays.Contains(value) ? "selected" : null;
                                    <option value="@value" selected="@isSelected">@d</option>
                                }
                            </select>
                            <small class="text-muted">Hold Ctrl (Windows) or Cmd (Mac) to select multiple</small>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label">Meal #</label>
                            <input name="AssignedFoods[@i].MealNumber"
                                   class="form-control"
                                   type="number"
                                   min="1"
                                   value="@( (int)food.MealNumber )" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Notes</label>
                            <input name="AssignedFoods[@i].Notes" class="form-control" value="@food.Notes" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-danger remove-food">X</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <button type="button" id="add-food" class="btn btn-success">Add Food</button>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Save Changes</button>
</form>
