@model OnlineCoaching.Domain.Dtos.ExerciseDto

@{
    ViewData["Title"] = "Delete Exercise";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Delete Exercise</h3>
        </div>
        <div class="card-body">
            <h5 class="text-danger fw-bold mb-3">
                Are you sure you want to delete this exercise?
            </h5>

            <dl class="row">
                <dt class="col-sm-3 fw-bold">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3 fw-bold">Muscle</dt>
                <dd class="col-sm-9">@Model.MuscleName</dd>

                <dt class="col-sm-3 fw-bold">Image</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Url.Content(Model.ImageUrl)" alt="Exercise Image" class="rounded" width="100" />
                    }
                    else
                    {
                        <span class="text-muted fst-italic">No image</span>
                    }
                </dd>

                <dt class="col-sm-3 fw-bold">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3 fw-bold">Video</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.VideoUrl))
                    {
                        <a href="@Model.VideoUrl" target="_blank">Watch Video</a>
                    }
                    else
                    {
                        <span class="text-muted">No video</span>
                    }
                </dd>

                <dt class="col-sm-3 fw-bold">Links</dt>
                <dd class="col-sm-9">
                    @if (Model.LinkUrls != null && Model.LinkUrls.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var link in Model.LinkUrls)
                            {
                                <li><a href="@link" target="_blank">@link</a></li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">No links</span>
                    }
                </dd>
            </dl>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>