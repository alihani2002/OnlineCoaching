@model OnlineCoaching.Domain.Dtos.ExerciseDto

@{
    ViewData["Title"] = "Delete Exercise";
}

<h2>Delete Exercise</h2>

<h4>Are you sure you want to delete this exercise?</h4>
<hr />

<div class="card p-3">
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Day</dt>
        <dd class="col-sm-10">@Model.Day</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Muscle</dt>
        <dd class="col-sm-10">@Model.MuscleName</dd>

        <dt class="col-sm-2">Video</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.VideoUrl))
            {
                <a href="@Model.VideoUrl" target="_blank">Watch Video</a>
            }
            else
            {
                <span class="text-muted">No video</span>
            }
        </dd>

        <dt class="col-sm-2">Links</dt>
        <dd class="col-sm-10">
            @if (Model.LinkUrls != null && Model.LinkUrls.Any())
            {
                <ul>
                    @foreach (var link in Model.LinkUrls)
                    {
                        <li><a href="@link" target="_blank">@link</a></li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">No links</span>
            }
        </dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
