@using OnlineCoaching.WebUI.Models.RequestPackage
@using OnlineCoaching.Domain.Enums
@model AssignViewModel

@{
    ViewData["Title"] = "Assign Exercises & Foods";
}

<h2 class="mb-4">Assign to Client</h2>

<form asp-action="Assign" asp-controller="Exercises" method="post">
    <input type="hidden" asp-for="ClientId" />
    <input type="hidden" asp-for="RequestId" />

    <!-- Exercises Section -->
    <div class="mb-5 p-4 border rounded shadow-sm bg-light">
        <h4 class="mb-3">Assign Exercises</h4>
        <div id="exercise-container">
            @for (int i = 0; i < Model.Exercises!.Count; i++)
            {
                var ex = Model.Exercises[i];
                ex.SelectedDays = ex.SelectedDays ?? new List<int>();

                <div class="exercise-item mb-3 p-3 border rounded bg-white">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <label asp-for="Exercises[i].ExerciseId" class="form-label">Exercise</label>
                            <select asp-for="Exercises[i].ExerciseId"
                                    asp-items="@(new SelectList(Model.AvailableExercises, "Id", "Name"))"
                                    class="form-select"></select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Exercises[i].Sets" class="form-label">Sets</label>
                            <input asp-for="Exercises[i].Sets" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Exercises[i].Reps" class="form-label">Reps</label>
                            <input asp-for="Exercises[i].Reps" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Days</label>
                            <select name="Exercises[@i].SelectedDays" multiple class="form-select">
                                @foreach (DayOfWeekEnum d in Enum.GetValues(typeof(DayOfWeekEnum)))
                                {
                                    var value = (int)d;
                                    var isSelected = ex.SelectedDays.Contains(value) ? "selected" : null;
                                    <option value="@value" selected="@isSelected">@d</option>
                                }
                            </select>
                            <small class="text-muted">Hold Ctrl (Windows) or Cmd (Mac) to select multiple</small>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Exercises[i].Notes" class="form-label">Notes</label>
                            <input asp-for="Exercises[i].Notes" class="form-control" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-danger remove-exercise">X</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <button type="button" id="add-exercise" class="btn btn-success">Add Exercise</button>
    </div>

    <!-- Foods Section -->
    <div class="mb-5 p-4 border rounded shadow-sm bg-light">
        <h4 class="mb-3">Assign Foods</h4>
        <div id="food-container">
            @for (int i = 0; i < Model.Foods!.Count; i++)
            {
                var food = Model.Foods[i];
                food.SelectedDays = food.SelectedDays ?? new List<int>();

                <div class="food-item mb-3 p-3 border rounded bg-white">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <label asp-for="Foods[i].FoodId" class="form-label">Food</label>
                            <select asp-for="Foods[i].FoodId"
                                    asp-items="@(new SelectList(Model.AvailableFoods, "Id", "Name"))"
                                    class="form-select"></select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Foods[i].Quantity" class="form-label">Quantity (g/ml)</label>
                            <input asp-for="Foods[i].Quantity" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Foods[i].NumberOfServings" class="form-label">Servings</label>
                            <input asp-for="Foods[i].NumberOfServings" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Days</label>
                            <select name="Foods[@i].SelectedDays" multiple class="form-select">
                                @foreach (DayOfWeekEnum d in Enum.GetValues(typeof(DayOfWeekEnum)))
                                {
                                    var value = (int)d;
                                    var isSelected = food.SelectedDays.Contains(value) ? "selected" : null;
                                    <option value="@value" selected="@isSelected">@d</option>
                                }
                            </select>
                            <small class="text-muted">Hold Ctrl (Windows) or Cmd (Mac) to select multiple</small>
                        </div>
                        <div class="col-md-1">
                            <label asp-for="Foods[i].MealNumber" class="form-label">Meal #</label>
                            <input asp-for="Foods[i].MealNumber" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Foods[i].Notes" class="form-label">Notes</label>
                            <input asp-for="Foods[i].Notes" class="form-control" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-danger remove-food">X</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <button type="button" id="add-food" class="btn btn-success">Add Food</button>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Assign</button>
</form>

@section Scripts {
    <script>
        // Add Exercise
        document.getElementById('add-exercise').addEventListener('click', function () {
            let container = document.getElementById('exercise-container');
            let index = container.children.length;
            let template = `
                <div class="exercise-item mb-3 p-3 border rounded bg-white">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <label class="form-label">Exercise</label>
                            <select name="Exercises[${index}].ExerciseId" class="form-select">
                                @foreach (var ex in Model.AvailableExercises!)
                                {
                                        <option value="@ex.Id">@ex.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2"><input name="Exercises[${index}].Sets" class="form-control" placeholder="Sets" /></div>
                        <div class="col-md-2"><input name="Exercises[${index}].Reps" class="form-control" placeholder="Reps" /></div>
                        <div class="col-md-3">
                            <label>Days</label>
                            <select name="Exercises[${index}].SelectedDays" multiple class="form-select">
                                @foreach (DayOfWeekEnum d in Enum.GetValues(typeof(DayOfWeekEnum)))
                                {
                                        var value = (int)d;
                                        <option value="@value">@d</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2"><input name="Exercises[${index}].Notes" class="form-control" placeholder="Notes" /></div>
                        <div class="col-md-1 d-flex align-items-end"><button type="button" class="btn btn-danger remove-exercise">X</button></div>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', template);
        });

        // Add Food
        document.getElementById('add-food').addEventListener('click', function () {
            let container = document.getElementById('food-container');
            let index = container.children.length;
            let template = `
                <div class="food-item mb-3 p-3 border rounded bg-white">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <select name="Foods[${index}].FoodId" class="form-select">
                                @foreach (var f in Model.AvailableFoods!)
                                {
                                        <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2"><input name="Foods[${index}].Quantity" class="form-control" placeholder="Qty" /></div>
                        <div class="col-md-2"><input name="Foods[${index}].NumberOfServings" class="form-control" type="number" min="1" placeholder="Servings" /></div>
                        <div class="col-md-2">
                            <label>Days</label>
                            <select name="Foods[${index}].SelectedDays" multiple class="form-select">
                                @foreach (DayOfWeekEnum d in Enum.GetValues(typeof(DayOfWeekEnum)))
                                {
                                        var value = (int)d;
                                        <option value="@value">@d</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1"><input name="Foods[${index}].MealNumber" class="form-control" type="number" min="1" placeholder="Meal #" /></div>
                        <div class="col-md-2"><input name="Foods[${index}].Notes" class="form-control" placeholder="Notes" /></div>
                        <div class="col-md-1 d-flex align-items-end"><button type="button" class="btn btn-danger remove-food">X</button></div>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', template);
        });

        // Remove Exercise/Food
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-exercise')) {
                e.target.closest('.exercise-item').remove();
            }
            if (e.target.classList.contains('remove-food')) {
                e.target.closest('.food-item').remove();
            }
        });
    </script>
}
