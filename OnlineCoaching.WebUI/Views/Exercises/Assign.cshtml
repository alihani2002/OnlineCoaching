<template id="exercise-template">
    <div class="form-row-item exercise-item">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Exercise</label>
                <select name="Exercises[__INDEX__].ExerciseId" class="form-select">
                    @foreach (var ex in Model.AvailableExercises!)
                    {
                        <option value="@ex.Id">@ex.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-1 col-6"><label class="form-label fw-bold">Sets</label><input name="Exercises[__INDEX__].Sets" class="form-control" placeholder="e.g., 3" /></div>
            <div class="col-md-1 col-6"><label class="form-label fw-bold">Reps</label><input name="Exercises[__INDEX__].Reps" class="form-control" placeholder="e.g., 12" /></div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Days</label>
                <div class="btn-group w-100 day-selector" role="group">
                    @foreach (DayOfWeekEnum d in Enum.GetValues(typeof(DayOfWeekEnum)))
                    {
                        var value = (int)d;
                        var dayId = $"ex-day-__INDEX__-{value}";
                        <input type="checkbox" class="btn-check" id="@dayId" name="Exercises[__INDEX__].SelectedDays" value="@value">
                        <label class="btn btn-outline-primary" for="@dayId">@d.ToString().Substring(0, 3)</label>
                    }
                </div>
            </div>
            <div class="col-md-2"><label class="form-label fw-bold">Notes</label><input name="Exercises[__INDEX__].Notes" class="form-control" placeholder="Optional" /></div>
            <div class="col-md-1 text-end"><button type="button" class="btn btn-danger remove-item" data-item-type="exercise"><i class="fas fa-trash"></i></button></div>
        </div>
    </div>
</template>

<template id="food-template">
    <div class="form-row-item food-item">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Food</label>
                <select name="Foods[__INDEX__].FoodId" class="form-select">
                    @foreach (var f in Model.AvailableFoods!)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 col-6"><label class="form-label fw-bold">Quantity (g/ml)</label><input name="Foods[__INDEX__].Quantity" class="form-control" placeholder="e.g., 150" /></div>
            <div class="col-md-1 col-6"><label class="form-label fw-bold">Servings</label><input name="Foods[__INDEX__].NumberOfServings" class="form-control" type="number" min="1" value="1" /></div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Days</label>
                <div class="btn-group w-100 day-selector" role="group">
                    @foreach (DayOfWeekEnum d in Enum.GetValues(typeof(DayOfWeekEnum)))
                    {
                        var value = (int)d;
                        var dayId = $"food-day-__INDEX__-{value}";
                        <input type="checkbox" class="btn-check" id="@dayId" name="Foods[__INDEX__].SelectedDays" value="@value">
                        <label class="btn btn-outline-primary" for="@dayId">@d.ToString().Substring(0, 3)</label>
                    }
                </div>
            </div>
            <div class="col-md-1 col-6"><label class="form-label fw-bold">Meal #</label><input name="Foods[__INDEX__].MealNumber" class="form-control" type="number" min="1" placeholder="e.g., 1" /></div>
            <div class="col-md-1 text-end"><button type="button" class="btn btn-danger remove-item" data-item-type="food"><i class="fas fa-trash"></i></button></div>
        </div>
    </div>
</template>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // --- Event Listeners ---
            document.getElementById('add-exercise').addEventListener('click', () => {
                addItem('exercise');
            });

            document.getElementById('add-food').addEventListener('click', () => {
                addItem('food');
            });

            document.addEventListener('click', function(e) {
                if (e.target.closest('.remove-item')) {
                    const button = e.target.closest('.remove-item');
                    const itemType = button.dataset.itemType; // 'exercise' or 'food'

                    button.closest(`.${itemType}-item`).remove();
                    reindexItems(itemType);
                }
            });

            // --- Core Functions ---

          
            function addItem(itemType) {
                const container = document.getElementById(`${itemType}-container`);
                const template = document.getElementById(`${itemType}-template`);
                const index = container.children.length;

                // Clone the template, replace the placeholder index, and add to the DOM
                const clone = template.content.cloneNode(true);
                const newHtml = clone.firstElementChild.outerHTML.replace(/__INDEX__/g, index);
                container.insertAdjacentHTML('beforeend', newHtml);
            }

           
            function reindexItems(itemType) {
                const container = document.getElementById(`${itemType}-container`);
                const items = container.querySelectorAll(`.${itemType}-item`);
                const collectionName = itemType === 'exercise' ? 'Exercises' : 'Foods';

                items.forEach((item, newIndex) => {
                    // Update inputs, selects, etc.
                    item.querySelectorAll('[name^="' + collectionName + '["]').forEach(el => {
                        el.name = el.name.replace(/\[\d+\]/, `[${newIndex}]`);
                    });

                    // Update day selector checkboxes and labels which have unique IDs
                    item.querySelectorAll('.btn-check').forEach(checkbox => {
                        const originalId = checkbox.id;
                        const value = originalId.split('-').pop(); // Get day value (e.g., '1')
                        const newId = `${itemType.substring(0,2)}-day-${newIndex}-${value}`;

                        checkbox.id = newId;
                        // Find the label associated with this checkbox and update its 'for' attribute
                        const label = item.querySelector(`label[for="${originalId}"]`);
                        if (label) {
                            label.setAttribute('for', newId);
                        }
                    });
                });
            }
        });
    </script>
}