@using OnlineCoaching.WebUI.Models.RequestPackage
@model AssignedListViewModel

@{
    ViewData["Title"] = "Assigned Exercises & Foods";
}

<div class="container py-4">
    <!-- Page Title & Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">
            Assigned Items for <span class="text-primary">Client #@Model.ClientId</span>
        </h2>
        <a asp-controller="CoachingPackageRequests" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle"></i> Back to Clients
        </a>
    </div>

    <!-- Assigned Exercises -->
    <div class="card shadow-sm mb-5 border-0 rounded-3">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <i class="bi bi-dumbbell me-2 fs-5"></i>
            <h5 class="mb-0">Assigned Exercises</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.AssignedExercises != null && Model.AssignedExercises.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Day</th>
                                <th>Exercise</th>
                                <th>Sets</th>
                                <th>Reps</th>
                                <th>Notes</th>
                                <th>Assigned On</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exercise in Model.AssignedExercises)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@exercise.DayOfWeek</span></td>
                                    <td>@exercise.Exercise?.Name</td>
                                    <td>@exercise.Sets</td>
                                    <td>@exercise.Reps</td>
                                    <td class="text-muted">@exercise.Notes</td>
                                    <td>@exercise.AssignedOn.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info m-3">
                    No exercises assigned yet.
                </div>
            }
        </div>
    </div>

    <!-- Assigned Foods -->
    <div class="card shadow-sm mb-5 border-0 rounded-3">
        <div class="card-header bg-success text-white d-flex align-items-center">
            <i class="bi bi-apple me-2 fs-5"></i>
            <h5 class="mb-0">Assigned Foods</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.AssignedFoods != null && Model.AssignedFoods.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Day</th>
                                <th>Food</th>
                                <th>Quantity</th>
                                <th>Notes</th>
                                <th>Assigned On</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var food in Model.AssignedFoods)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@food.DayOfWeek</span></td>
                                    <td>@food.Food?.Name</td>
                                    <td>@food.Quantity</td>
                                    <td class="text-muted">@food.Notes</td>
                                    <td>@food.AssignedOn.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info m-3">
                    No foods assigned yet.
                </div>
            }
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex gap-2">
        <a asp-action="EditAssigned" asp-route-clientId="@Model.ClientId" asp-route-requestId="@Model.RequestId"
           class="btn btn-warning">
            <i class="bi bi-pencil-square"></i> Edit Assignments
        </a>
        <a asp-action="Assign" asp-route-clientId="@Model.ClientId"
           class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Assign More
        </a>
    </div>
</div>
