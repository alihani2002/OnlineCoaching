@using OnlineCoaching.Domain.Enums
@using OnlineCoaching.WebUI.Models.RequestPackage
@model AssignedListViewModel

@{
    ViewData["Title"] = "Assigned Plan";

    // Helper to map the integer day value back to its Enum name for display
    string GetDayName(int dayValue)
    {
        if (Enum.IsDefined(typeof(DayOfWeekEnum), dayValue))
        {
            return ((DayOfWeekEnum)dayValue).ToString();
        }
        return "Unknown";
    }
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h2 class="fw-bold text-dark mb-0">
            Assigned Plan for <span class="text-primary">Client #@Model.ClientId</span>
        </h2>
        <div class="d-flex gap-2">
            <a asp-action="EditAssigned" asp-route-clientId="@Model.ClientId" asp-route-requestId="@Model.RequestId" class="btn btn-warning shadow-sm">
                <i class="bi bi-pencil-square me-1"></i> Edit Full Plan
            </a>
            <a asp-action="Assign" asp-route-clientId="@Model.ClientId" asp-route-requestId="@Model.RequestId" class="btn btn-warning shadow-sm">
                <i class="bi bi-pencil-square me-1"></i> Assign More Plan
            </a>
            <a asp-controller="CoachingPackageRequests" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle me-1"></i> Back
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-5 border-0 rounded-3">
        <div class="card-header bg-light border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-dumbbell me-2"></i>Assigned Exercises</h5>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.AssignedExercises != null && Model.AssignedExercises.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 25%;">Days</th>
                                <th>Exercise</th>
                                <th class="text-center">Sets</th>
                                <th class="text-center">Reps</th>
                                <th>Notes</th>
                                <th>Assigned</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exercise in Model.AssignedExercises)
                            {
                                <tr>
                                    <td>
                                        @if (exercise.SelectedDays != null && exercise.SelectedDays.Any())
                                        {
                                            foreach (var day in exercise.SelectedDays)
                                            {
                                                <span class="badge bg-primary bg-opacity-75 me-1">@GetDayName(day)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Not specified</span>
                                        }
                                    </td>
                                    <td class="fw-medium">@exercise.Exercise?.Name</td>
                                    <td class="text-center">@exercise.Sets</td>
                                    <td class="text-center">@exercise.Reps</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(exercise.Notes))
                                        {
                                            <span class="text-muted">@exercise.Notes</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">—</span>
                                        }
                                    </td>
                                    <td>@exercise.AssignedOn.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <i class="bi bi-info-circle-fill text-muted fs-1"></i>
                    <p class="mt-3 mb-0">No exercises have been assigned to this client yet.</p>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-light border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-success fw-bold"><i class="bi bi-apple me-2"></i>Assigned Foods</h5>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.AssignedFoods != null && Model.AssignedFoods.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 25%;">Days</th>
                                <th>Food</th>
                                <th class="text-center">Meal #</th>
                                <th>Quantity</th>
                                <th>Notes</th>
                                <th>Assigned</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var food in Model.AssignedFoods)
                            {
                                <tr>
                                    <td>
                                        @if (food.SelectedDays != null && food.SelectedDays.Any())
                                        {
                                            foreach (var day in food.SelectedDays)
                                            {
                                                <span class="badge bg-success bg-opacity-75 me-1">@GetDayName(day)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Not specified</span>
                                        }
                                    </td>
                                    <td class="fw-medium">@food.Food?.Name</td>
                                    <td class="text-center">@food.MealNumber</td>
                                    <td>@food.Quantity g/ml</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(food.Notes))
                                        {
                                            <span class="text-muted">@food.Notes</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">—</span>
                                        }
                                    </td>
                                    <td>@food.AssignedOn.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <i class="bi bi-info-circle-fill text-muted fs-1"></i>
                    <p class="mt-3 mb-0">No foods have been assigned to this client yet.</p>
                </div>
            }
        </div>
    </div>
</div>
