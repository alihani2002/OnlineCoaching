@using OnlineCoaching.WebUI.Models.RequestPackage
@model AssignedListViewModel

@{
    ViewData["Title"] = "Assigned Exercises & Foods";
}

<h2>Assigned Items for Client @Model.ClientId</h2>

<hr />

<h3>Assigned Exercises</h3>
@if (Model.AssignedExercises != null && Model.AssignedExercises.Any())
{
    <table class="table table-striped table-bordered text-white" style="background-color:#222;">
        <thead style="background-color:#444;">
            <tr>
                <th>Day</th>
                <th>Exercise</th>
                <th>Sets</th>
                <th>Reps</th>
                <th>Notes</th>
                <th>Assigned On</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var exercise in Model.AssignedExercises)
            {
                <tr>
                    <td>@exercise.DayOfWeek</td>
                    <td>@exercise.Exercise?.Name</td>
                    <td>@exercise.Sets</td>
                    <td>@exercise.Reps</td>
                    <td>@exercise.Notes</td>
                    <td>@exercise.AssignedOn.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No exercises assigned yet.</p>
}

<hr />

<h3>Assigned Foods</h3>
@if (Model.AssignedFoods != null && Model.AssignedFoods.Any())
{
    <table class="table table-striped table-bordered text-white" style="background-color:#222;">
        <thead style="background-color:#444;">
            <tr>
                <th>Day</th>
                <th>Food</th>
                <th>Quantity</th>
                <th>Notes</th>
                <th>Assigned On</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var food in Model.AssignedFoods)
            {
                <tr>
                    <td>@food.DayOfWeek</td>
                    <td>@food.Food?.Name</td>
                    <td>@food.Quantity</td>
                    <td>@food.Notes</td>
                    <td>@food.AssignedOn.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No foods assigned yet.</p>
}

<div class="mt-3">
    <a asp-action="EditAssigned" asp-route-clientId="@Model.ClientId" asp-route-requestId="@Model.RequestId" class="btn btn-warning">
        ✏️ Edit Assignments
    </a>
    <a asp-action="Assign" asp-route-clientId="@Model.ClientId" class="btn btn-success">➕ Assign More</a>
    <a asp-action="CoachingPackageRequests" class="btn btn-secondary">⬅️ Back to Clients</a>
</div>
