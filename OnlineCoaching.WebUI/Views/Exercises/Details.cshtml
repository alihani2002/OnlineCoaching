@model OnlineCoaching.Domain.Dtos.ExerciseDto

@{
    ViewData["Title"] = "Exercise Details";
}

<h2>@Model.Name</h2>

<p><strong>Rest:</strong> @Model.Rest</p>
<p><strong>Day:</strong> @Model.Day</p>
<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Video:</strong> <a href="@Model.VideoUrl" target="_blank">@Model.VideoUrl</a></p>
<p><strong>Muscle:</strong> @Model.MuscleName</p>

<h4>Links</h4>
<ul>
    @foreach (var link in Model.LinkUrls)
    {
        <li><a href="@link" target="_blank">@link</a></li>
    }
</ul>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
