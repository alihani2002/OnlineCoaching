@model OnlineCoaching.Domain.Dtos.ExerciseDto

@{
    ViewData["Title"] = "Exercise Details";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="fw-bold mb-4 text-dark">@Model.Name</h2>

            <dl class="row mb-4">
                <dt class="col-sm-3 fw-bold">Muscle</dt>
                <dd class="col-sm-9">@Model.MuscleName</dd>

                <dt class="col-sm-3 fw-bold">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <dt class="col-sm-3 fw-bold">Video</dt>
                    <dd class="col-sm-9">
                        <a href="@Model.VideoUrl" target="_blank" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-play-circle me-1"></i> Watch Video
                        </a>
                    </dd>
                }
            </dl>

            @if (Model.LinkUrls != null && Model.LinkUrls.Any())
            {
                <h5 class="fw-bold mt-4">Additional Links</h5>
                <ul class="list-unstyled">
                    @foreach (var link in Model.LinkUrls)
                    {
                        <li>
                            <a href="@link" target="_blank" class="text-decoration-none">
                                <i class="bi bi-link-45deg me-1"></i> @link
                            </a>
                        </li>
                    }
                </ul>
            }

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="bi bi-arrow-left-circle me-1"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>