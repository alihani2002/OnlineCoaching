@model IEnumerable<OnlineCoaching.Domain.Dtos.ExerciseDto>

@{
    ViewData["Title"] = "Exercises";
}

<h2>Exercises</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ New Exercise</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>image</th>
            <th>Muscle</th>
            <th>Video</th>
            <th>Links</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@Url.Content(item.ImageUrl)" alt="@item.Name" width="100" height="100" style="object-fit:cover;" />
                    }
                    else
                    {
                        <span class="text-muted">No image</span>
                    }
                </td>
                <td>@item.MuscleName</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.VideoUrl))
                    {
                        <a href="@item.VideoUrl" target="_blank">Video</a>
                    }
                </td>
                <td>
                    @foreach (var link in item.LinkUrls)
                    {
                        <div><a href="@link" target="_blank">@link</a></div>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
