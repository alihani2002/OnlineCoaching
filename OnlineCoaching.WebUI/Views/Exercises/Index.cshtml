@model IEnumerable<OnlineCoaching.Domain.Dtos.ExerciseDto>

@{
    ViewData["Title"] = "Manage Exercises";
    // Assuming DataTables CSS and Bootstrap Icons are loaded in _Layout.cshtml
}

<link rel="stylesheet" href="~/css/Exercise-Index.css" />
<link rel="stylesheet" href="~/assets/scss/Exercise-Index.scss" />


<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">
            <i class="fas fa-dumbbell me-2 text-primary"></i> Manage Exercises
        </h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm">
            <i class="fas fa-plus-circle me-2"></i> Add New Exercise
        </a>
    </div>

    <div class="card shadow-lg border-0  overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive m-5">
                <table id="exercisesTable" class="display table table-hover align-middle w-100">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th class="fw-semibold">Name</th>
                            <th class="fw-semibold text-center">Image</th>
                            <th class="fw-semibold">Muscle Group</th>
                            <th class="fw-semibold text-center">Video</th>
                            <th class="fw-semibold text-center">Links</th>
                            <th class="fw-semibold text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold" data-label="Name:">@item.Name</td>
                                <td class="text-center" data-label="Image:">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@Url.Content(item.ImageUrl)"
                                             alt="@item.Name"
                                             class="rounded shadow-sm border"
                                             width="80" height="80"
                                             style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">No image</span>
                                    }
                                </td>
                                <td data-label="Muscle Group:">
                                    <span class="badge bg-secondary px-3 py-1 rounded-pill">@item.MuscleName</span>
                                </td>
                                <td class="text-center" data-label="Video:">
                                    @if (!string.IsNullOrEmpty(item.VideoUrl))
                                    {
                                        <button class="btn btn-outline-primary btn-sm rounded-pill"
                                                onclick="openVideoModal('@item.VideoUrl', '@item.Name')">
                                            <i class="fas fa-play-circle me-1"></i> Watch
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center" data-label="Links:">
                                    @if (item.LinkUrls != null && item.LinkUrls.Any())
                                    {
                                        <div class="d-flex flex-column align-items-center">
                                            @foreach (var link in item.LinkUrls)
                                            {
                                                <a href="@link" target="_blank" class="text-decoration-none text-info small my-1">
                                                    <i class="fas fa-link me-1"></i> View Link
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No links</span>
                                    }
                                </td>
                                <td class="text-center" data-label="Actions:">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light dropdown-toggle border shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fas fa-ellipsis-v"></i> Actions
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="fas fa-info-circle me-2 text-info"></i>Details</a></li>
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="fas fa-pencil-alt me-2 text-warning"></i>Edit</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="fas fa-trash-alt me-2"></i>Delete</a></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="videoModalLabel">Exercise Video</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9">
                    <div id="videoContainer" class="d-flex align-items-center justify-content-center bg-dark">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#exercisesTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                columnDefs: [
                    { orderable: false, targets: [1, 3, 4, 5] } // Disable ordering on Image, Video, Links, Actions
                ],
                order: [[0, 'asc']]
            });
        });

        const videoModal = document.getElementById('videoModal');
        const videoContainer = document.getElementById("videoContainer");
        const videoModalTitle = document.getElementById("videoModalLabel");

        // Clear video content when modal is hidden to stop playback
        videoModal.addEventListener('hidden.bs.modal', function () {
            videoContainer.innerHTML = '';
        });

        function openVideoModal(url, name) {
            let embedHtml = "";
            videoModalTitle.textContent = `${name} Video Demonstration`;

            if (url.includes("youtube.com") || url.includes("youtu.be")) {
                // Extract YouTube video ID
                let videoId = "";
                if (url.includes("youtu.be")) {
                    videoId = url.split("/").pop();
                } else {
                    const urlObj = new URL(url);
                    const urlParams = new URLSearchParams(urlObj.search);
                    videoId = urlParams.get("v");
                }
                embedHtml = `<iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1"
                             frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                             allowfullscreen class="embed-responsive-item"></iframe>`;
            } else if (url.includes("vimeo.com")) {
                const videoId = url.split("/").pop();
                embedHtml = `<iframe src="https://player.vimeo.com/video/${videoId}?autoplay=1"
                             frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen class="embed-responsive-item"></iframe>`;
            } else {
                // For direct links (.mp4, etc.) or unknown sources
                embedHtml = `<video controls autoplay class="embed-responsive-item">
                                 <source src="${url}" type="video/mp4">
                                 Your browser does not support the video tag.
                             </video>`;
            }

            videoContainer.innerHTML = embedHtml;
            // Use Bootstrap 5's direct instantiation
            new bootstrap.Modal(videoModal).show();
        }
    </script>
}