@model IEnumerable<OnlineCoaching.Domain.Dtos.ExerciseDto>

@{
    ViewData["Title"] = "Exercises";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Exercises</h2>
        <a asp-action="Create" class="btn btn-primary shadow">
            <i class="bi bi-plus-circle-fill me-2"></i> Add New Exercise
        </a>
    </div>

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <div class="card shadow-lg rounded-4">
        <div class="card-body p-0">
            <table id="exercisesTable" class="display table table-hover align-middle mb-0" style="width:100%">
                <thead class="bg-light text-center">
                    <tr>
                        <th class="text-secondary fw-semibold">Name</th>
                        <th class="text-secondary fw-semibold">Image</th>
                        <th class="text-secondary fw-semibold">Muscle</th>
                        <th class="text-secondary fw-semibold">Video</th>
                        <th class="text-secondary fw-semibold">Links</th>
                        <th class="text-secondary fw-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@Url.Content(item.ImageUrl)"
                                         alt="@item.Name"
                                         class="rounded shadow-sm border"
                                         width="80" height="80"
                                         style="object-fit:cover;" />
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">No image</span>
                                }
                            </td>
                            <td>@item.MuscleName</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.VideoUrl))
                                {
                                    <button class="btn btn-outline-primary btn-sm"
                                            onclick="openVideoModal('@item.VideoUrl')">
                                        <i class="bi bi-play-circle"></i> Watch
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (item.LinkUrls != null && item.LinkUrls.Any())
                                {
                                    @foreach (var link in item.LinkUrls)
                                    {
                                        <div>
                                            <a href="@link" target="_blank" class="text-decoration-none text-info">
                                                <i class="bi bi-link-45deg"></i> Link
                                            </a>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">No links</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-info-circle me-2"></i>Details</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil-square me-2"></i>Edit</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash-fill me-2"></i>Delete</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">Exercise Video</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div id="videoContainer"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#exercisesTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                order: [[0, 'asc']]
            });
        });

        function openVideoModal(url) {
            let embedHtml = "";

            if (url.includes("youtube.com") || url.includes("youtu.be")) {
                // Extract YouTube video ID
                let videoId = "";
                if (url.includes("youtu.be")) {
                    videoId = url.split("/").pop();
                } else {
                    const urlParams = new URLSearchParams(new URL(url).search);
                    videoId = urlParams.get("v");
                }
                embedHtml = `<iframe width="100%" height="450" src="https://www.youtube.com/embed/${videoId}"
                              frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                              allowfullscreen></iframe>`;
            } else if (url.includes("vimeo.com")) {
                const videoId = url.split("/").pop();
                embedHtml = `<iframe src="https://player.vimeo.com/video/${videoId}" width="100%" height="450"
                              frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
            } else if (url.endsWith(".mp4")) {
                embedHtml = `<video width="100%" height="450" controls>
                                <source src="${url}" type="video/mp4">
                                Your browser does not support the video tag.
                             </video>`;
            } else {
                embedHtml = `<a href="${url}" target="_blank" class="btn btn-primary">Open Video</a>`;
            }

            document.getElementById("videoContainer").innerHTML = embedHtml;
            new bootstrap.Modal(document.getElementById('videoModal')).show();
        }
    </script>
}
