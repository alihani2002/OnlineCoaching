@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="forgot-password-confirm-area section-bg d-flex align-items-center justify-content-center"
         style="min-height:80vh; background:#f7f7f7;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9">
                <div class="card shadow-lg p-5 border-0" style="border-radius:20px; background:#fff;">

                    <!-- Header -->
                    <div class="text-center mb-4">
                        <a asp-controller="Home" asp-action="Index">
                            <img src="~/assets/img/logo/logo.png" alt="Logo" style="height:70px;" />
                        </a>
                        <h2 class="mt-3 fw-bold text-success">@ViewData["Title"]</h2>
                        <p class="text-muted">
                            Please check your email to reset your password.
                        </p>
                    </div>

                    <!-- Back to Login -->
                    <div class="text-center mt-4">
                        <a asp-area="Identity" asp-page="/Account/Login"
                           class="btn btn-primary"
                           style="border-radius:30px; font-weight:600;">
                            Back to Login
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
