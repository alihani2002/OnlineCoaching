@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="login-area section-bg d-flex align-items-center justify-content-center" style="min-height:80vh; background:#f7f7f7;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9">
                <div class="card shadow-lg p-5 border-0" style="border-radius:20px; background:#fff;">
                    <div class="text-center mb-4">
                        <a asp-controller="Home" asp-action="Index">
                            <img src="~/assets/img/logo/logo.png" alt="Logo" style="height:70px;" />
                        </a>
                        <h2 class="mt-3 fw-bold">Welcome Back</h2>
                        <p class="text-muted">Log in to continue your training journey</p>
                    </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3" role="alert"></div>

                        <div class="form-group mb-3">
                            <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="Email" autocomplete="username" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <input asp-for="Input.Password" class="form-control form-control-lg" placeholder="Password" autocomplete="current-password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label" asp-for="Input.RememberMe"></label>
                            </div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-primary fw-bold">Forgot password?</a>
                        </div>

                        <button id="login-submit" type="submit"
                                class="btn btn-primary w-100 py-3 fs-5"
                                style="border-radius:40px; font-weight:600;">
                            Log in
                        </button>

                        <div class="text-center mt-4">
                            <p>
                                Don't have an account?
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold">
                                    Sign up
                                </a>
                            </p>
                        </div>
                    </form>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="text-center mt-4">
                            <p class="text-muted">Or log in with</p>
                            <div>
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" form="external-account" name="provider" value="@provider.Name"
                                            class="btn btn-outline-dark mx-1 px-4 py-2" style="border-radius:30px;">
                                        @provider.DisplayName
                                    </button>
                                }
                            </div>
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post"></form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
