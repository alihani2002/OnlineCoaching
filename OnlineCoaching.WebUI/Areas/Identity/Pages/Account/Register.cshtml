@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure it uses your custom layout
}

<!-- Register Section -->
<section class="contact-section section-padding" style="min-height:80vh; background:#f7f7f7;">
    <div class="container">
        <div class="row justify-content-center">
            <!-- Register Form -->
            <div class="col-lg-6 col-md-8">
                <div class="form-wrapper p-5 shadow rounded">
                    <h2 class="mb-4 text-center">Create a New Account</h2>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <input asp-for="Input.Email" class="form-control" placeholder="Email Address" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <input asp-for="Input.FullName" class="form-control" placeholder="Full Name" />
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <input asp-for="Input.Age" class="form-control" placeholder="Age" />
                            <span asp-validation-for="Input.Age" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button id="registerSubmit" type="submit" class="btn btn-primary w-100">
                            Register
                        </button>
                    </form>

                    <div class="text-center text-danger mt-4">
                        <p>Already have an account? <a class="text-center text-danger mt-4" asp-page="/Account/Login">Login here</a></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- External logins -->
        @if (Model.ExternalLogins?.Count > 0)
        {
            <div class="row mt-5">
                <div class="col-lg-6 mx-auto text-center">
                    <h5 class="mb-3">Or Register With</h5>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-dark m-1" name="provider" value="@provider.Name">
                                @provider.DisplayName
                            </button>
                        }
                    </form>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
