@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="forgot-password-area section-bg d-flex align-items-center justify-content-center"
         style="min-height:80vh; background:#f7f7f7;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9">
                <div class="card shadow-lg p-5 border-0" style="border-radius:20px; background:#fff;">

                    <!-- Header -->
                    <div class="text-center mb-4">
                        <a asp-controller="Home" asp-action="Index">
                            <img src="~/assets/img/logo/logo.png" alt="Logo" style="height:70px;" />
                        </a>
                        <h2 class="mt-3 fw-bold">Forgot your password?</h2>
                        <p class="text-muted">Enter your email to reset your password</p>
                    </div>

                    <!-- Form -->
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3" role="alert"></div>

                        <div class="form-group mb-3">
                            <input asp-for="Input.Email" class="form-control form-control-lg"
                                   placeholder="name@example.com" autocomplete="username" aria-required="true" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100 py-3 fs-5"
                                style="border-radius:40px; font-weight:600;">
                            Reset Password
                        </button>
                    </form>

                    <!-- Back to Login -->
                    <div class="text-center mt-4">
                        <p>
                            Remembered your password?
                            <a asp-area="Identity" asp-page="/Account/Login" class="fw-bold" style="color:red">
                                Log in
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
