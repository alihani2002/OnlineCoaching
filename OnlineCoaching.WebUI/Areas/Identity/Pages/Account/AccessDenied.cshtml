@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <h1 class="display-4 text-danger mb-3">@ViewData["Title"]</h1>
                    <p class="lead mb-4">You do not have permission to access this page or perform this action.</p>
                    <i class="bi bi-shield-lock display-1 text-danger mb-4"></i> <!-- optional icon if Bootstrap Icons are included -->
                    <div>
                        <a href="~/" class="btn btn-danger btn-lg">Go to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
        font-family: Arial, sans-serif;
       
    }
</style>
